    "This device is signed in to another server. To switch, open Settings › Account, sign out and choose Change Server, then open the link again.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gerät ist bei einem anderen Server angemeldet. Öffne zum Wechseln Einstellungen › Account, melde dich ab, wähle „Server ändern“ und öffne dann den Link erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo tiene la sesión iniciada en otro servidor. Para cambiar, abre Ajustes › Cuenta, cierra sesión, elige «Cambiar servidor» y vuelve a abrir el enlace."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet appareil est connecté à un autre serveur. Pour changer, ouvrez Réglages › Compte, déconnectez-vous et choisissez « Changer de serveur », puis rouvrez le lien."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo dispositivo ha effettuato l’accesso a un altro server. Per cambiare, apri Impostazioni › Account, esci e scegli Cambia server, poi apri di nuovo il link."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスは別のサーバにサインインしています。切り替えるには、「設定 › アカウント」を開いてサインアウトし、「サーバを変更」を選択してから、もう一度リンクを開いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기는 다른 서버에 로그인되어 있습니다. 전환하려면 설정 › 계정을 열고 로그아웃한 다음 서버 변경을 선택한 후 링크를 다시 여세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo está conectado a outro servidor. Para trocar, abra Ajustes › Conta, saia e escolha Alterar Servidor, depois abra o link de novo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备已登录另一台服务器。若要切换，请打开“设置”›“账户”，退出登录并选择“更改服务器”，然后再次打开该链接。"
          }
        }
      }
    },
