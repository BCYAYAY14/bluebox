    "Sync keeps My List, watch progress and profiles the same on your iPhone, iPad and Mac.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sync hält „Meine Liste“, Wiedergabefortschritt und Profile auf deinem iPhone, iPad und Mac gleich."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sincronización mantiene Mi lista, el progreso y los perfiles iguales en tu iPhone, iPad y Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La synchronisation garde Ma liste, la progression et les profils identiques sur votre iPhone, votre iPad et votre Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La sincronizzazione mantiene La mia lista, i progressi di visione e i profili uguali su iPhone, iPad e Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同期により、マイリスト、視聴の進行状況、プロフィールがiPhone、iPad、Macで同じになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동기화는 iPhone, iPad, Mac에서 내 리스트, 시청 진행 상황, 프로필을 동일하게 유지합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A sincronização mantém Minha Lista, progresso e perfis iguais no iPhone, no iPad e no Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同步可使你的 iPhone、iPad 和 Mac 上的“我的列表”、观看进度和个人资料保持一致。"
          }
        }
      }
    },
