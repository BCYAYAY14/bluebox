    "You're offline. Connect to the internet, or play a download.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bist offline. Verbinde dich mit dem Internet oder spiele einen Download ab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin conexión. Conéctate a internet o reproduce una descarga."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous êtes hors ligne. Connectez-vous à Internet ou lisez un téléchargement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei offline. Connettiti a internet, oppure riproduci un download."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフラインです。インターネットに接続するか、ダウンロードを再生してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오프라인 상태입니다. 인터넷에 연결하거나 다운로드한 콘텐츠를 재생하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você está offline. Conecte-se à internet ou reproduza um download."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你已离线。请连接互联网，或播放下载内容。"
          }
        }
      }
    },
    "You're offline. Downloaded titles still play; connect to the internet to stream.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bist offline. Geladene Titel laufen weiterhin; verbinde dich zum Streamen mit dem Internet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin conexión. Los títulos descargados se siguen reproduciendo; conéctate a internet para transmitir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous êtes hors ligne. Les titres téléchargés restent lisibles ; connectez-vous à Internet pour diffuser."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei offline. I titoli scaricati si riproducono comunque; connettiti a internet per lo streaming."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフラインです。ダウンロードしたタイトルは引き続き再生できます。ストリーミングするにはインターネットに接続してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오프라인 상태입니다. 다운로드한 콘텐츠는 계속 재생할 수 있으며, 스트리밍하려면 인터넷에 연결하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você está offline. Os títulos baixados ainda tocam; conecte-se à internet para transmitir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你已离线。已下载的标题仍可播放；连接互联网即可串流。"
          }
        }
      }
    },
    "You're offline. The catalog loads again by itself when you reconnect.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bist offline. Der Katalog lädt von selbst neu, sobald du wieder verbunden bist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin conexión. El catálogo se vuelve a cargar solo cuando te reconectes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous êtes hors ligne. Le catalogue se recharge tout seul à la reconnexion."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei offline. Il catalogo si ricarica da solo quando ti riconnetti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフラインです。再接続すると、カタログは自動的に再読み込みされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오프라인 상태입니다. 다시 연결하면 카탈로그가 자동으로 다시 로드됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você está offline. O catálogo carrega de novo sozinho quando você se reconectar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你已离线。重新连接后，目录会自动重新载入。"
          }
        }
      }
    },
