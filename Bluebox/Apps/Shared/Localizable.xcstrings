    "Watched downloads stay until you delete them, and the next episodes aren't fetched.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gesehene Downloads bleiben, bis du sie löschst, und die nächsten Folgen werden nicht geladen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las descargas vistas se conservan hasta que las elimines, y no se obtienen los próximos episodios."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les téléchargements vus restent jusqu’à ce que vous les supprimiez, et les prochains épisodes ne sont pas récupérés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I download guardati restano finché non li elimini e i prossimi episodi non vengono scaricati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "視聴済みのダウンロードは削除するまで残り、次のエピソードは取得されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시청한 다운로드는 삭제할 때까지 유지되며 다음 에피소드는 가져오지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os downloads assistidos ficam até você apagá-los, e os próximos episódios não são buscados."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已观看的下载内容会保留到你删除为止，且不会获取后续剧集。"
          }
        }
      }
    },
