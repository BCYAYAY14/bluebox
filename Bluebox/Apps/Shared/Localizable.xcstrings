    "Downloads Bluebox starts by itself wait until 1–6 am.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Von Bluebox selbst gestartete Downloads warten bis 1–6 Uhr."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las descargas que Bluebox inicia por sí mismo esperan hasta la 1–6 h."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les téléchargements lancés par Bluebox attendent entre 1 h et 6 h du matin."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I download avviati da Bluebox attendono le 1–6 di notte."
