    "Listening on this device. Tap again to stop.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hört auf diesem Gerät zu. Tippe erneut, um zu stoppen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escuchando en este dispositivo. Toca de nuevo para detener."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écoute sur cet appareil. Touchez de nouveau pour arrêter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In ascolto su questo dispositivo. Tocca di nuovo per fermare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスで聞き取り中です。もう一度タップすると停止します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
