    "Saved torrent metrics are deleted. A stream that's playing starts a new file next time.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gesicherte Torrent-Werte werden gelöscht. Ein laufender Stream beginnt beim nächsten Mal eine neue Datei."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las métricas de torrents guardadas se eliminan. Una transmisión en curso empieza un archivo nuevo la próxima vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les mesures de torrents enregistrées sont supprimées. Un flux en cours de lecture démarre un nouveau fichier la prochaine fois."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le metriche dei torrent salvate vengono eliminate. Uno stream in riproduzione inizierà un nuovo file la prossima volta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存したトレントのメトリクスは削除されます。再生中のストリームは、次回新しいファイルから始まります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 토렌트 지표가 삭제됩니다. 재생 중인 스트림은 다음에 새 파일로 시작됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As métricas de torrents salvas são apagadas. Um stream em reprodução começa um novo arquivo na próxima vez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已存储的种子指标将被删除。正在播放的串流下次会开始新文件。"
          }
        }
      }
    },
