    "Home's hero plays a muted trailer. Previews never play on mobile data or in Low Data Mode.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das große Titelbild auf dem Home spielt einen stummen Trailer. Vorschauen laufen nie über mobile Daten oder im Datensparmodus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El destacado de Inicio reproduce un avance sin sonido. Los avances nunca se reproducen con datos móviles ni en modo de datos bajos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le héros de l’accueil lit une bande-annonce sans le son. Les aperçus ne sont jamais lus en données mobiles ni en mode économie de données."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il video principale di Home riproduce un trailer senza audio. Le anteprime non vengono mai riprodotte con la rete cellulare o in Modalità Dati ridotti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホームのメインエリアでは、消音したトレーラーが再生されます。モバイルデータ通信中や低データモードでは、プレビューは再生されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "홈의 대표 영역에서는 음소거된 예고편이 재생됩니다. 모바일 데이터 또는 저데이터 모드에서는 미리보기가 재생되지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O destaque do Início reproduz um trailer sem som. As prévias nunca tocam com dados móveis nem no Modo de Dados Reduzidos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主页的主推位会播放静音预告片。预告片绝不会在移动数据或低数据模式下播放。"
          }
        }
      }
    },
