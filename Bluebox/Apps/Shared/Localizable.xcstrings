    "Colours highlights, progress, the Bluebox logo and the Dock icon. Finder keeps showing the blue icon.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Färbt Hervorhebungen, Fortschritt, das Bluebox-Logo und das Dock-Symbol. Im Finder erscheint weiterhin das blaue Symbol."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia el color de los elementos destacados, el progreso, el logotipo de Bluebox y el icono del Dock. El Finder sigue mostrando el icono azul."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Colore les éléments en surbrillance, la progression, le logo Bluebox et l’icône du Dock. Le Finder continue d’afficher l’icône bleue."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Colora evidenziazioni, progressi, il logo Bluebox e l’icona del Dock. Il Finder continua a mostrare l’icona blu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ハイライト、進行状況、Blueboxのロゴ、Dockアイコンの色を変更します。Finderには引き続きブルーのアイコンが表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "강조 표시, 진행 막대, Bluebox 로고, Dock 아이콘의 색상을 바꿉니다. Finder에는 계속 파란색 아이콘이 표시됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Colore destaques, progresso, o logo do Bluebox e o ícone do Dock. O Finder continua mostrando o ícone azul."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为高亮、进度、Bluebox 标志和程序坞图标着色。访达仍显示蓝色图标。"
          }
        }
      }
    },
    "Colours highlights, progress, the Bluebox logo and the app icon on your Home Screen.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Färbt Hervorhebungen, Fortschritt, das Bluebox-Logo und das App-Symbol auf deinem Home-Bildschirm."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia el color de los elementos destacados, el progreso, el logotipo de Bluebox y el icono de la app en la pantalla de inicio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Colore les éléments en surbrillance, la progression, le logo Bluebox et l’icône de l’app sur votre écran d’accueil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Colora evidenziazioni, progressi, il logo Bluebox e l’icona dell’app nella schermata Home."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ハイライト、進行状況、Blueboxのロゴ、ホーム画面のAppアイコンの色を変更します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "강조 표시, 진행 막대, Bluebox 로고, 홈 화면의 앱 아이콘의 색상을 바꿉니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Colore destaques, progresso, o logo do Bluebox e o ícone do app na Tela de Início."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为高亮、进度、Bluebox 标志和主屏幕上的 App 图标着色。"
          }
        }
      }
    },
