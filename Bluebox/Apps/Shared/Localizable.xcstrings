    "Watching on another device or Trakt counts too, so this device keeps up.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Ansehen auf einem anderen Gerät oder bei Trakt zählt ebenfalls, damit dieses Gerät auf dem Laufenden bleibt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que ves en otro dispositivo o en Trakt también cuenta, así que este dispositivo se mantiene al día."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Regarder sur un autre appareil ou sur Trakt compte aussi : cet appareil reste à jour."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conta anche la visione su un altro dispositivo o su Trakt, quindi questo dispositivo resta al passo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "他のデバイスやTraktでの視聴もカウントされるため、このデバイスも最新の状態になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 기기나 Trakt에서 시청한 것도 집계되므로 이 기기도 최신 상태를 유지합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que você assiste em outro dispositivo ou no Trakt também conta, então este dispositivo acompanha."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在其他设备或 Trakt 上的观看同样计入，因此此设备会保持同步。"
          }
        }
      }
    },
