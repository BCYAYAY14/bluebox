    "Streaming on mobile data is off. Connect to Wi‑Fi, or change Settings › Mobile Data › Streaming.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Streaming über mobile Daten ist aus. Verbinde dich mit WLAN oder ändere Einstellungen › Mobile Daten › Streaming."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La transmisión con datos móviles está desactivada. Conéctate a Wi‑Fi o cambia Ajustes › Datos móviles › Transmisión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le streaming en données mobiles est désactivé. Connectez-vous au Wi‑Fi ou modifiez Réglages › Données mobiles › Streaming."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo streaming con la rete cellulare è disattivato. Connettiti al Wi‑Fi, oppure modifica Impostazioni › Rete cellulare › Streaming."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モバイルデータ通信でのストリーミングはオフです。Wi‑Fiに接続するか、「設定 › モバイルデータ通信 › ストリーミング」を変更してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모바일 데이터로 스트리밍이 꺼져 있습니다. Wi‑Fi에 연결하거나 설정 › 모바일 데이터 › 스트리밍을 변경하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O streaming com dados móveis está desativado. Conecte-se ao Wi‑Fi ou altere Ajustes › Dados Móveis › Streaming."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移动数据串流已关闭。请连接无线局域网，或更改“设置”›“移动数据”›“串流”。"
          }
        }
      }
    },
