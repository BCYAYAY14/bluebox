    "Dialogue Boost": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dialogverstärkung"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Realce de diálogos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Renforcement des dialogues"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Potenzia dialoghi"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダイアログブースト"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대사 강화"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reforço de Diálogo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对白增强"
          }
        }
      }
    },
    "Dialogue Boost lifts speech; Night Mode evens out loud and quiet scenes. You can also change these for each video in the player's Tools. The audio language is each profile's, in Languages.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Dialogverstärkung hebt Sprache an; der Nachtmodus gleicht laute und leise Szenen aus. Du kannst beides auch für jedes Video in den Werkzeugen des Players ändern. Die Tonsprache gehört zum Profil, unter „Sprachen“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«Realce de diálogos» eleva las voces; «Modo noche» equilibra las escenas fuertes y las silenciosas. También puedes cambiarlos para cada video en las Herramientas del reproductor. El idioma del audio es el de cada perfil, en Idiomas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le renforcement des dialogues met la voix en avant ; le mode nuit égalise les scènes fortes et calmes. Vous pouvez aussi les modifier pour chaque vidéo dans les Outils du lecteur. La langue audio est celle de chaque profil, dans Langues."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Potenzia dialoghi esalta il parlato; Modalità notte uniforma le scene rumorose e quelle silenziose. Puoi modificarli anche per ogni video dagli Strumenti del lettore. La lingua audio è quella di ogni profilo, in Lingue."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「ダイアログブースト」は声を聞き取りやすくし、「ナイトモード」は大きな音と小さな音の差をならします。ビデオごとの変更は、プレーヤーの「ツール」でも行えます。オーディオ言語はプロフィールごとに「言語」で設定します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대사 강화는 음성을 높이고, 야간 모드는 큰 소리와 작은 소리를 고르게 합니다. 플레이어의 도구에서 비디오별로 변경할 수도 있습니다. 오디오 언어는 프로필별로 언어에서 설정합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Reforço de Diálogo realça a fala; o Modo Noturno equilibra cenas altas e baixas. Você também pode alterar isso para cada vídeo nas Ferramentas do player. O idioma do áudio é de cada perfil, em Idiomas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“对白增强”会提升人声；“夜间模式”会平衡响亮和安静场景的音量。你也可以在播放器的“工具”中为每个视频更改。音频语言按个人资料设置，位于“语言”中。"
          }
        }
      }
    },
    "Dialogue Boost lifts speech; Night Mode evens out loud and quiet scenes. You can also change these for each video in the player's Tools. The audio language is each profile's, on the Language page.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dialogverstärkung hebt Sprache hervor; der Nachtmodus gleicht laute und leise Szenen an. Du kannst beides auch für jedes Video in den Werkzeugen des Players ändern. Die Audiosprache gehört zu jedem Profil, auf der Seite „Sprache“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Realzar diálogos sube las voces; el modo nocturno iguala las escenas fuertes y suaves. También puedes cambiarlos para cada vídeo en Herramientas del reproductor. El idioma del audio es de cada perfil, en la página Idioma."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le renfort des dialogues met en avant les voix ; le mode nuit égalise les scènes fortes et calmes. Vous pouvez aussi les modifier pour chaque vidéo dans les Outils du lecteur. La langue audio est propre à chaque profil, sur la page Langue."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Potenzia dialoghi mette in risalto le voci; la modalità notte uniforma le scene forti e quelle silenziose. Puoi cambiarli anche per ogni video negli Strumenti del player. La lingua audio è di ciascun profilo, nella pagina Lingua."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダイアログブーストは声を聞き取りやすくし、ナイトモードは大きな場面と静かな場面の音量差をならします。プレーヤーのツールでビデオごとに変更することもできます。音声の言語はプロファイルごとで、「言語」ページにあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대사 강조는 목소리를 키우고, 야간 모드는 큰 장면과 조용한 장면의 차이를 줄입니다. 플레이어의 도구에서 동영상마다 바꿀 수도 있습니다. 오디오 언어는 프로필마다 다르며 언어 페이지에 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Realçar diálogos destaca as falas; o modo noturno equilibra cenas altas e baixas. Você também pode mudá-los em cada vídeo nas Ferramentas do player. O idioma do áudio é de cada perfil, na página Idioma."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对白增强让人声更清晰；夜间模式平衡响亮和安静的场景。你也可以在播放器的“工具”中为每个视频单独更改。音频语言属于每个个人资料，在“语言”页面中设置。"
          }
        }
      }
    },
