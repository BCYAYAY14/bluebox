      }
    },
    "You'll be signed out on this device. Your library stays here and in the project, and you can connect to another project.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du wirst auf diesem Gerät abgemeldet. Deine Mediathek bleibt hier und im Projekt, und du kannst dich mit einem anderen Projekt verbinden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se cerrará la sesión en este dispositivo. Tu biblioteca se queda aquí y en el proyecto, y puedes conectarte a otro proyecto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous serez déconnecté sur cet appareil. Votre bibliothèque reste ici et dans le projet, et vous pouvez vous connecter à un autre projet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accesso verrà chiuso su questo dispositivo. La libreria resta qui e nel progetto, e puoi connetterti a un altro progetto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスからサインアウトされます。ライブラリはこことプロジェクトに残り、別のプロジェクトに接続できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에서 로그아웃됩니다. 보관함은 여기와 프로젝트에 유지되며 다른 프로젝트에 연결할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você sairá da conta neste dispositivo. Sua biblioteca permanece aqui e no projeto, e você pode se conectar a outro projeto."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你将在此设备上退出登录。你的资料库保留在此处和项目中，你可以连接到其他项目。"
          }
        }
      }
    },
    "You'll join at the same moment as everyone.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du steigst im selben Moment ein wie alle anderen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te unirás en el mismo momento que todos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous rejoindrez au même moment que tout le monde."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrerai nello stesso momento di tutti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "みんなと同じ場面から参加します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모두와 같은 장면에서 참여합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você vai entrar no mesmo momento que todos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你会和大家在同一时刻加入。"
          }
        }
      }
    },
    "You'll sign in with this on your other devices. No email needed.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Damit meldest du dich auf deinen anderen Geräten an. Keine E-Mail nötig."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Iniciarás sesión con esto en tus otros dispositivos. No hace falta correo electrónico."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous vous connecterez avec ceci sur vos autres appareils. Aucun e-mail requis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Userai questo per accedere sugli altri dispositivi. Non serve alcuna email."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "他のデバイスでこれを使ってサインインします。メールは不要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 기기에서 이 정보로 로그인합니다. 이메일은 필요하지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você vai entrar com isto nos seus outros dispositivos. Sem precisar de e-mail."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你将在其他设备上使用此信息登录。无需电子邮件。"
          }
        }
      }
    },
