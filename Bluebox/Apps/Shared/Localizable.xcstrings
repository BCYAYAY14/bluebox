    "Try another preferred language, or turn on more sites, in Settings › Subtitles.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Versuche eine andere bevorzugte Sprache oder schalte unter Einstellungen › Untertitel weitere Seiten ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Prueba otro idioma preferido o activa más sitios en Ajustes › Subtítulos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Essayez une autre langue préférée ou activez d’autres sites dans Réglages › Sous-titres."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prova un’altra lingua preferita, oppure attiva più siti, in Impostazioni › Sottotitoli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「設定 › 字幕」で別の優先言語をお試しいただくか、サイトをさらにオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 선호 언어를 시도하거나 설정 › 자막에서 더 많은 사이트를 켜세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tente outro idioma preferido ou ative mais sites em Ajustes › Legendas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在“设置”›“字幕”中尝试其他首选语言，或开启更多站点。"
