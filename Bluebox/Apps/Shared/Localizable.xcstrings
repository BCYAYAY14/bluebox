    "While adjustments are on, HDR video plays in standard range.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Solange Anpassungen aktiv sind, wird HDR-Video im Standardbereich abgespielt."
