    "AVPlayer plays MP4 and MOV with Picture in Picture and AirPlay. VLC plays MKV, AVI, WebM and the rest.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "AVPlayer spielt MP4 und MOV mit Bild-in-Bild und AirPlay ab. VLC spielt MKV, AVI, WebM und alles andere ab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "AVPlayer reproduce MP4 y MOV con Imagen en imagen y AirPlay. VLC reproduce MKV, AVI, WebM y el resto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "AVPlayer lit les MP4 et MOV avec l’image dans l’image et AirPlay. VLC lit les MKV, AVI, WebM et tout le reste."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "AVPlayer riproduce MP4 e MOV con Picture in Picture e AirPlay. VLC riproduce MKV, AVI, WebM e il resto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AVPlayerはMP4とMOVをピクチャインピクチャとAirPlayで再生します。VLCはMKV、AVI、WebMなどその他の形式を再生します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AVPlayer는 MP4와 MOV를 사진 속 사진 및 AirPlay와 함께 재생합니다. VLC는 MKV, AVI, WebM 등 나머지를 재생합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O AVPlayer reproduz MP4 e MOV com Imagem em Imagem e AirPlay. O VLC reproduz MKV, AVI, WebM e o resto."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AVPlayer 播放 MP4 和 MOV，支持画中画和 AirPlay。VLC 播放 MKV、AVI、WebM 及其他格式。"
          }
        }
      }
    },
