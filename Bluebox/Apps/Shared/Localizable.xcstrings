    "Your library stays on this device and in your project. Sign in again to resume syncing.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Mediathek bleibt auf diesem Gerät und in deinem Projekt. Melde dich erneut an, um die Synchronisierung fortzusetzen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu biblioteca se queda en este dispositivo y en tu proyecto. Inicia sesión de nuevo para reanudar la sincronización."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre bibliothèque reste sur cet appareil et dans votre projet. Reconnectez-vous pour reprendre la synchronisation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua libreria resta su questo dispositivo e nel tuo progetto. Accedi di nuovo per riprendere la sincronizzazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブラリはこのデバイスとプロジェクトに残ります。同期を再開するには、もう一度サインインしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보관함은 이 기기와 프로젝트에 유지됩니다. 동기화를 다시 시작하려면 다시 로그인하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua biblioteca permanece neste dispositivo e no seu projeto. Entre de novo para retomar a sincronização."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的资料库保留在此设备和你的项目中。重新登录以恢复同步。"
          }
        }
      }
    },
    "Your library stays on this device.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Mediathek bleibt auf diesem Gerät."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu biblioteca se queda en este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
