    "Videos stream on Wi‑Fi only. Downloads play anywhere.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Videos streamen nur über WLAN. Downloads laufen überall."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los videos se transmiten solo con Wi‑Fi. Las descargas se reproducen en cualquier lugar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les vidéos sont diffusées en Wi‑Fi uniquement. Les téléchargements se lisent partout."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I video vengono trasmessi solo con Wi‑Fi. I download si riproducono ovunque."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ビデオはWi‑Fiでのみストリーミングされます。ダウンロードはどこでも再生できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비디오는 Wi‑Fi에서만 스트리밍됩니다. 다운로드는 어디서나 재생됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os vídeos são transmitidos somente no Wi‑Fi. Os downloads tocam em qualquer lugar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "视频仅通过无线局域网串流。下载内容可随处播放。"
          }
        }
      }
    },
