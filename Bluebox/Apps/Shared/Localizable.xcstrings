        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Blueboxが自動で開始するダウンロードは、午前1～6時まで待機します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluebox가 자동으로 시작하는 다운로드는 오전 1~6시까지 기다립니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os downloads que o Bluebox inicia sozinho esperam até 1–6 h."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluebox 自动开始的下载会等到凌晨 1 点至 6 点。"
          }
        }
      }
    },
