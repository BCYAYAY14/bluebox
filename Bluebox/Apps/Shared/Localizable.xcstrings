            "value": "すべてのビデオの開始時の設定"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 비디오 시작 시"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo Vídeo Começa Com"
          }
        },
        "zh-Hans": {
          "stringUnit": {
