          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "VLC reproduce todo lo que puede. Imagen en imagen y AirPlay no están disponibles con VLC."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "VLC lit tout ce qu’il peut. L’image dans l’image et AirPlay ne sont pas disponibles avec VLC."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "VLC riproduce tutto ciò che può. Picture in Picture e AirPlay non sono disponibili con VLC."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "VLCは再生できるものをすべて再生します。VLCではピクチャインピクチャとAirPlayは使用できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "VLC는 가능한 모든 것을 재생합니다. VLC에서는 사진 속 사진과 AirPlay를 사용할 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
