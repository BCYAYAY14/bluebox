    "Listens to a couple of minutes of speech and lines the subtitles up, drift included.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hört ein paar Minuten Sprache an und richtet die Untertitel danach aus, auch bei Abdriften."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escucha un par de minutos de voz y sincroniza los subtítulos, incluido el desfase."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écoute quelques minutes de dialogue et aligne les sous-titres, dérive comprise."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ascolta un paio di minuti di parlato e allinea i sottotitoli, deriva inclusa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "数分間の音声を聞き取り、ずれも含めて字幕を同期します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "몇 분간의 음성을 듣고 어긋남까지 포함해 자막을 맞춥니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouve alguns minutos de fala e alinha as legendas, inclusive o desvio."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "聆听几分钟语音并对齐字幕，包括偏移。"
          }
        }
      }
    },
