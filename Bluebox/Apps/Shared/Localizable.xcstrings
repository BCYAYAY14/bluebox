            "value": "你的资料库保留在此设备上。"
          }
        }
      }
    },
    "Your list is empty": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Liste ist leer"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu lista está vacía"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre liste est vide"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua lista è vuota"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リストは空です"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "리스트가 비어 있음"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua lista está vazia"
          }
        },
        "zh-Hans": {
