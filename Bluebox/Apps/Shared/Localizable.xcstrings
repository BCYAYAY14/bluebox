    "Keep My List in step with your Trakt watchlist and send what you finish to your history.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte „Meine Liste“ mit deiner Trakt-Watchlist synchron und sende, was du fertig siehst, an deinen Verlauf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén Mi lista sincronizada con tu lista de seguimiento de Trakt y envía a tu historial lo que termines."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronisez Ma liste avec votre liste de suivi Trakt et envoyez ce que vous terminez dans votre historique."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantieni La mia lista allineata alla tua watchlist di Trakt e invia ciò che finisci alla tua cronologia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マイリストをTraktのウォッチリストと同期し、視聴を完了した作品を履歴に送信します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 리스트를 Trakt 워치리스트와 동기화하고 끝까지 본 콘텐츠를 기록으로 보냅니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha a Minha Lista sincronizada com sua lista de interesse do Trakt e envie o que você termina ao seu histórico."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使“我的列表”与你的 Trakt 待看清单保持一致，并将你看完的内容发送到你的历史记录。"
          }
        }
      }
    },
