    "Click **Create new project** and wait a minute or two until the dashboard says it's ready.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicke auf **Create new project** und warte ein bis zwei Minuten, bis das Dashboard meldet, dass es bereit ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en **Create new project** y espera un par de minutos hasta que el panel indique que está listo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez sur **Create new project** et attendez une minute ou deux jusqu’à ce que le tableau de bord indique qu’il est prêt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai clic su **Create new project** e attendi uno o due minuti finché la dashboard non indica che è pronto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "**Create new project**をクリックして、ダッシュボードに準備完了と表示されるまで1～2分待ちます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "**새 프로젝트 만들기**를 클릭하고 대시보드에 준비 완료가 표시될 때까지 1~2분 기다리세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique em **Create new project** e espere um ou dois minutos até o painel indicar que está pronto."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击 **Create new project**，等待一两分钟，直到控制台显示已就绪。"
          }
        }
      }
    },
    "Click **New project**. Name it `Bluebox`, pick the region nearest you, and keep the **Free** plan.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicke auf **New project**. Nenne es `Bluebox`, wähle die nächstgelegene Region und behalte den **Free**-Plan."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en **New project**. Llámalo `Bluebox`, elige la región más cercana y mantén el plan **Free**."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez sur **New project**. Nommez-le `Bluebox`, choisissez la région la plus proche de vous et gardez l’offre **Free**."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai clic su **New project**. Chiamalo `Bluebox`, scegli la regione più vicina e mantieni il piano **Free**."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "**New project**をクリックします。名前を`Bluebox`にし、最寄りのリージョンを選んで、**Free**プランのままにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "**New project**를 클릭합니다. 이름은 `Bluebox`로 하고, 가장 가까운 지역을 선택한 다음 **Free** 요금제를 유지하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique em **New project**. Dê o nome `Bluebox`, escolha a região mais próxima e mantenha o plano **Free**."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击 **New project**。命名为 `Bluebox`，选择离你最近的区域，并保留 **Free** 方案。"
          }
        }
      }
    },
