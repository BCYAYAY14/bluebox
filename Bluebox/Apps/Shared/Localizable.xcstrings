    "New episodes download on Wi‑Fi as they come out.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neue Folgen werden über WLAN geladen, sobald sie erscheinen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los episodios nuevos se descargan con Wi‑Fi en cuanto salen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les nouveaux épisodes se téléchargent en Wi‑Fi dès leur sortie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I nuovi episodi si scaricano con Wi‑Fi non appena escono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいエピソードは、公開されるとWi‑Fiでダウンロードされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 에피소드는 공개되는 대로 Wi‑Fi로 다운로드됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Novos episódios são baixados no Wi‑Fi assim que saem."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新剧集发布时通过无线局域网下载。"
          }
        }
      }
    },
    "New episodes download on Wi‑Fi as they come out. Everything here follows Settings › Downloads until you change it.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neue Folgen werden über WLAN geladen, sobald sie erscheinen. Alles hier folgt Einstellungen › Downloads, bis du es änderst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los episodios nuevos se descargan con Wi‑Fi en cuanto salen. Todo lo de aquí sigue Ajustes › Descargas hasta que lo cambies."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les nouveaux épisodes se téléchargent en Wi‑Fi dès leur sortie. Tout ce qui est ici suit Réglages › Téléchargements tant que vous ne le modifiez pas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I nuovi episodi si scaricano con Wi‑Fi non appena escono. Tutto qui segue Impostazioni › Download finché non lo modifichi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいエピソードは、公開されるとWi‑Fiでダウンロードされます。変更するまで、ここでのすべての設定は「設定 › ダウンロード」に従います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 에피소드는 공개되는 대로 Wi‑Fi로 다운로드됩니다. 변경하기 전까지 여기의 모든 항목은 설정 › 다운로드를 따릅니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Novos episódios são baixados no Wi‑Fi assim que saem. Tudo aqui segue Ajustes › Downloads até você alterar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新剧集发布时通过无线局域网下载。在你更改之前，这里的一切都遵循“设置”›“下载”。"
          }
        }
      }
    },
