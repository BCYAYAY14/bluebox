            "value": "No se cargaron las búsquedas populares ni los géneros. Comprueba tu conexión e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les recherches populaires et les genres n’ont pas pu se charger. Vérifiez votre connexion, puis réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le ricerche principali e i generi non si sono caricati. Controlla la connessione, poi riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "人気の検索とジャンルを読み込めませんでした。接続を確認して、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인기 검색어와 장르를 불러오지 못했습니다. 연결 상태를 확인한 다음 다시 시도하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os Mais Buscados e os gêneros não carregaram. Verifique sua conexão e tente de novo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "热门搜索和类型未能载入。请检查网络连接，然后重试。"
          }
        }
      }
    },
