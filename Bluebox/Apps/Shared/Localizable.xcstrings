            "state": "translated",
            "value": "Die zugehörige Liste und der Wiedergabefortschritt werden von allen deinen Geräten entfernt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su Mi lista y su progreso se eliminan de todos tus dispositivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa liste et sa progression sont supprimées de tous vos appareils."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La sua lista e i progressi di visione vengono rimossi da tutti i tuoi dispositivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マイリストと視聴の進行状況がすべてのデバイスから削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 리스트와 시청 진행 상황이 모든 기기에서 제거됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Minha Lista e o progresso dele são removidos de todos os seus dispositivos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其“我的列表”和观看进度将从你的所有设备中移除。"
          }
        }
      }
    },
    "Its add-on was removed or turned off, or the catalog was taken out of it.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sein Add-on wurde entfernt oder ausgeschaltet, oder der Katalog wurde daraus entfernt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su complemento se eliminó o se desactivó, o el catálogo se quitó de él."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son add-on a été supprimé ou désactivé, ou le catalogue en a été retiré."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il suo componente aggiuntivo è stato rimosso o disattivato, oppure il catalogo ne è stato tolto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アドオンが削除またはオフにされたか、カタログがアドオンから外されました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "애드온이 제거되었거나 꺼졌거나, 카탈로그가 애드온에서 빠졌습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O complemento foi removido ou desativado, ou o catálogo foi retirado dele."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其插件已被移除或关闭，或该目录已从插件中删除。"
          }
        }
      }
    },
    "Its downloaded files are deleted from this device.": {
