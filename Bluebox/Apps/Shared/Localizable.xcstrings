      }
    },
    "Installing took too long, so Bluebox stopped waiting. Nothing was changed. Try again, or download Bluebox from GitHub.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Installation dauerte zu lange, daher hat Bluebox nicht länger gewartet. Es wurde nichts geändert. Versuche es erneut oder lade Bluebox von GitHub."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La instalación tardó demasiado, así que Bluebox dejó de esperar. No se cambió nada. Inténtalo de nuevo o descarga Bluebox desde GitHub."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’installation a pris trop de temps, Bluebox a cessé d’attendre. Rien n’a été modifié. Réessayez ou téléchargez Bluebox depuis GitHub."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’installazione ha richiesto troppo tempo, quindi Bluebox ha smesso di attendere. Non è stato modificato nulla. Riprova, oppure scarica Bluebox da GitHub."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インストールに時間がかかりすぎたため、Blueboxは待機を中止しました。変更は行われていません。もう一度お試しいただくか、GitHubからBlueboxをダウンロードしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설치에 너무 오래 걸려 Bluebox가 대기를 중단했습니다. 변경된 것은 없습니다. 다시 시도하거나 GitHub에서 Bluebox를 다운로드하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A instalação demorou demais, então o Bluebox parou de esperar. Nada foi alterado. Tente de novo ou baixe o Bluebox do GitHub."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安装耗时过长，Bluebox 已停止等待。未做任何更改。请重试，或从 GitHub 下载 Bluebox。"
          }
        }
      }
    },
    "Intro and credits times shared on TheIntroDB and IntroDB fill in when a file has no chapters. Mark a wrong time from the player.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf TheIntroDB und IntroDB geteilte Intro- und Abspannzeiten werden eingesetzt, wenn eine Datei keine Kapitel hat. Melde eine falsche Zeit im Player."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los tiempos de intro y créditos compartidos en TheIntroDB e IntroDB se usan cuando un archivo no tiene capítulos. Marca un tiempo incorrecto desde el reproductor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les repères d’intro et de générique partagés sur TheIntroDB et IntroDB s’appliquent quand un fichier n’a pas de chapitres. Signalez un repère erroné depuis le lecteur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tempi di intro e titoli di coda condivisi su TheIntroDB e IntroDB compaiono quando un file non ha capitoli. Segnala un tempo errato dal lettore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルにチャプターがない場合は、TheIntroDBとIntroDBで共有されているイントロとクレジットの時間が使われます。間違っている時間はプレーヤーから報告できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일에 챕터가 없으면 TheIntroDB와 IntroDB에 공유된 인트로 및 크레딧 시간이 채워집니다. 잘못된 시간은 플레이어에서 표시하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os tempos de intro e créditos compartilhados no TheIntroDB e no IntroDB entram quando um arquivo não tem capítulos. Marque um tempo errado pelo player."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当文件没有章节时，会使用 TheIntroDB 和 IntroDB 上分享的片头和片尾时间。可在播放器中标记错误的时间。"
          }
        }
      }
    },
