    "More at once finishes a queue sooner but splits your bandwidth.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mehr gleichzeitig arbeitet eine Warteschlange schneller ab, teilt aber deine Bandbreite."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Más a la vez termina antes la cola, pero reparte tu ancho de banda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus à la fois termine la file plus tôt mais partage votre bande passante."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Più alla volta finisce prima la coda ma divide la tua banda."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同時に多く進めると待ち行列は早く終わりますが、帯域を分け合います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 번에 더 많이 받으면 대기열이 빨리 끝나지만 대역폭이 나뉩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mais de uma vez termina a fila antes, mas divide sua banda."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同时下载更多可更快完成队列，但会分摊带宽。"
          }
        }
      }
    },
    "More at once finishes a queue sooner but splits your bandwidth. With Wi‑Fi Only, downloads wait for Wi‑Fi instead of using mobile data.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mehr gleichzeitig beendet eine Warteschlange früher, teilt aber deine Bandbreite auf. Mit „Nur WLAN“ warten Downloads auf WLAN, statt mobile Daten zu nutzen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Más a la vez termina antes una cola, pero reparte tu ancho de banda. Con «Solo Wi‑Fi», las descargas esperan a una red Wi‑Fi en lugar de usar datos móviles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus de téléchargements simultanés termine la file plus vite mais répartit votre bande passante. Avec « Wi‑Fi uniquement », les téléchargements attendent le Wi‑Fi au lieu d’utiliser les données mobiles."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Più download contemporanei finiscono prima la coda ma dividono la banda. Con solo Wi‑Fi, i download attendono il Wi‑Fi invece di usare la rete cellulare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同時に多く実行するとキューは早く終わりますが、帯域が分割されます。「Wi‑Fiのみ」では、ダウンロードはモバイルデータ通信を使わずWi‑Fiを待ちます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 번에 더 많이 받으면 대기열이 빨리 끝나지만 대역폭이 나뉩니다. Wi‑Fi 전용인 경우 다운로드는 모바일 데이터를 사용하지 않고 Wi‑Fi를 기다립니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mais ao mesmo tempo termina uma fila mais cedo, mas divide sua banda. Com Somente Wi‑Fi, os downloads esperam pelo Wi‑Fi em vez de usar dados móveis."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同时下载更多可更快完成队列，但会分摊带宽。选择“仅无线局域网”时，下载会等待无线局域网，而不使用移动数据。"
          }
        }
      }
    },
