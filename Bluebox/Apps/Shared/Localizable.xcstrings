    "Only AVPlayer is used, so MKV, AVI and WebM won't play.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wird nur AVPlayer verwendet, daher werden MKV, AVI und WebM nicht abgespielt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se usa AVPlayer, así que MKV, AVI y WebM no se reproducirán."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seul AVPlayer est utilisé : les MKV, AVI et WebM ne seront pas lus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Viene usato solo AVPlayer, quindi MKV, AVI e WebM non verranno riprodotti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AVPlayerのみを使用するため、MKV、AVI、WebMは再生されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AVPlayer만 사용하므로 MKV, AVI, WebM은 재생되지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Somente o AVPlayer é usado, então MKV, AVI e WebM não serão reproduzidos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅使用 AVPlayer，因此无法播放 MKV、AVI 和 WebM。"
          }
        }
      }
    },
    "Only I Control Playback": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur ich steuere die Wiedergabe"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo yo controlo la reproducción"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je suis seul à contrôler la lecture"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo io controllo la riproduzione"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再生を操作できるのは自分だけ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "나만 재생 제어"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só eu controlo a reprodução"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅我可控制播放"
          }
        }
      }
    },
    "Only add links you have the right to stream. MP4, MOV, M4V and HLS (.m3u8) are supported.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge nur Links hinzu, die du streamen darfst. MP4, MOV, M4V und HLS (.m3u8) werden unterstützt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade solo enlaces que tengas derecho a transmitir. Se admiten MP4, MOV, M4V y HLS (.m3u8)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "N’ajoutez que des liens que vous avez le droit de diffuser. Les formats MP4, MOV, M4V et HLS (.m3u8) sont pris en charge."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi solo link che hai il diritto di riprodurre in streaming. Sono supportati MP4, MOV, M4V e HLS (.m3u8)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ストリーミングする権利のあるリンクのみ追加してください。MP4、MOV、M4V、HLS（.m3u8）に対応しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스트리밍할 권리가 있는 링크만 추가하세요. MP4, MOV, M4V, HLS(.m3u8)가 지원됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione apenas links que você tem o direito de transmitir. MP4, MOV, M4V e HLS (.m3u8) são compatíveis."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅添加你有权串流的链接。支持 MP4、MOV、M4V 和 HLS (.m3u8)。"
          }
        }
      }
    },
    "Only add torrents you have the right to download and watch. Video files are matched to the catalog by name. MP4, MOV and M4V play while downloading.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge nur Torrents hinzu, die du laden und ansehen darfst. Videodateien werden per Name dem Katalog zugeordnet. MP4, MOV und M4V laufen schon während des Ladens."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade solo torrents que tengas derecho a descargar y ver. Los archivos de video se asocian al catálogo por nombre. MP4, MOV y M4V se reproducen mientras se descargan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "N’ajoutez que des torrents que vous avez le droit de télécharger et de regarder. Les fichiers vidéo sont associés au catalogue par leur nom. Les MP4, MOV et M4V se lisent pendant le téléchargement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi solo torrent che hai il diritto di scaricare e guardare. I file video vengono abbinati al catalogo per nome. MP4, MOV e M4V si riproducono durante il download."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダウンロードして視聴する権利のあるトレントのみ追加してください。ビデオファイルは名前でカタログと照合されます。MP4、MOV、M4Vはダウンロード中でも再生できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다운로드하여 시청할 권리가 있는 토렌트만 추가하세요. 비디오 파일은 이름으로 카탈로그와 일치됩니다. MP4, MOV, M4V는 다운로드하는 동안 재생됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione apenas torrents que você tem o direito de baixar e assistir. Os arquivos de vídeo são associados ao catálogo pelo nome. MP4, MOV e M4V são reproduzidos durante o download."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅添加你有权下载和观看的种子。视频文件会按名称匹配目录。MP4、MOV 和 M4V 可边下载边播放。"
          }
        }
      }
    },
    "Only connect to a server you set up, or one someone you trust gave you: the username and password you enter next go to it, and your library syncs there.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbinde dich nur mit einem Server, den du eingerichtet hast oder der dir von jemandem gegeben wurde, dem du vertraust: Benutzername und Passwort, die du als Nächstes eingibst, gehen dorthin, und deine Mediathek wird dorthin synchronisiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conéctate solo a un servidor que hayas configurado tú o que te haya dado alguien de confianza: el nombre de usuario y la contraseña que introduzcas a continuación se envían a él, y tu biblioteca se sincroniza allí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne vous connectez qu’à un serveur que vous avez configuré, ou que vous a donné une personne de confiance : le nom d’utilisateur et le mot de passe saisis ensuite lui sont envoyés, et votre bibliothèque s’y synchronise."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Connettiti solo a un server che hai configurato tu, o che ti ha dato una persona di cui ti fidi: nome utente e password che inserisci dopo vanno a lui, e la tua libreria si sincronizza lì."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分で設定したサーバ、または信頼できる人から提供されたサーバにのみ接続してください。次に入力するユーザ名とパスワードがそこに送信され、ライブラリもそこに同期されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "직접 설정했거나 신뢰할 수 있는 사람이 제공한 서버에만 연결하세요. 다음에 입력하는 사용자 이름과 암호가 해당 서버로 전송되고 보관함이 그곳에 동기화됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecte-se apenas a um servidor que você configurou ou que alguém de confiança lhe deu: o nome de usuário e a senha que você digitar a seguir vão para ele, e sua biblioteca é sincronizada lá."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅连接你自己设置的服务器，或你信任的人提供的服务器：你接下来输入的用户名和密码会发送给它，你的资料库也会同步到那里。"
          }
        }
      }
    },
    "Only debrid links play on mobile data; peer-to-peer uses more data and uploads.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Über mobile Daten werden nur Debrid-Links abgespielt; Peer-to-Peer braucht mehr Daten und lädt hoch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con datos móviles solo se reproducen enlaces debrid; el peer-to-peer usa más datos y sube contenido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuls les liens debrid sont lus en données mobiles ; le pair à pair consomme plus de données et envoie des données."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con la rete cellulare si riproducono solo link debrid; il peer-to-peer usa più dati e fa upload."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モバイルデータ通信で再生できるのはデブリッドリンクのみです。ピアツーピアはデータ通信量が増え、アップロードも発生します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모바일 데이터에서는 디브리드 링크만 재생됩니다. P2P는 데이터를 더 많이 사용하고 업로드도 합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Somente links debrid são reproduzidos com dados móveis; o peer-to-peer usa mais dados e faz uploads."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移动数据下仅播放 Debrid 链接；点对点会使用更多流量并上传数据。"
          }
        }
      }
    },
