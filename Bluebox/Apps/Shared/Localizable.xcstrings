    "Hidden titles stay out of Home's rows. They still appear in Search and My List.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausgeblendete Titel bleiben aus den Reihen auf dem Home. Sie erscheinen weiterhin in der Suche und in „Meine Liste“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los títulos ocultos no aparecen en las filas de Inicio. Siguen apareciendo en Buscar y en Mi lista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les titres masqués restent absents des rangées de l’accueil. Ils apparaissent toujours dans la recherche et Ma liste."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I titoli nascosti restano fuori dalle righe di Home. Compaiono comunque in Cerca e in La mia lista."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "非表示のタイトルは、ホームの行に表示されません。検索とマイリストには引き続き表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "숨긴 제목은 홈의 행에 표시되지 않습니다. 검색과 내 리스트에는 계속 표시됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Títulos ocultos ficam fora das fileiras da Tela Inicial. Eles ainda aparecem na Busca e em Minha Lista."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已隐藏的标题不会出现在主页的行中，但仍会出现在搜索和“我的列表”中。"
          }
        }
      }
    },
