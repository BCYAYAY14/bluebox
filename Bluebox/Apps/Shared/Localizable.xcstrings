    "Movies and episodes you start appear here, so you can pick up where you left off.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Filme und Folgen, die du beginnst, erscheinen hier, damit du dort weitermachen kannst, wo du aufgehört hast."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las películas y los episodios que empieces aparecen aquí, para que continúes donde lo dejaste."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les films et épisodes que vous commencez apparaissent ici, pour reprendre là où vous vous étiez arrêté."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I film e gli episodi che inizi compaiono qui, così puoi riprendere da dove avevi lasciato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "視聴を開始した映画やエピソードがここに表示され、続きから再生できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시청을 시작한 영화와 에피소드가 여기에 표시되어 중단한 지점부터 이어서 볼 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Filmes e episódios que você começa aparecem aqui, para continuar de onde parou."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你开始观看的电影和剧集会显示在这里，方便你从上次停止的地方继续。"
          }
        }
      }
    },
