        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desassociar"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消匹配"
          }
        }
      }
    },
    "Unmatch keeps the file in My Sources as it is, without a title. Matches are saved on this device.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Zuordnung aufheben“ behält die Datei unverändert und ohne Titel in „Meine Quellen“. Zuordnungen werden auf diesem Gerät gespeichert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quitar coincidencia deja el archivo en Mis fuentes tal cual, sin título. Las coincidencias se guardan en este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dissocier garde le fichier dans Mes sources tel quel, sans titre. Les correspondances sont enregistrées sur cet appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuovi abbinamento lascia il file in Le mie fonti così com’è, senza titolo. Gli abbinamenti sono salvati su questo dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一致を解除すると、ファイルはタイトルなしのまま「マイソース」に残ります。一致はこのデバイスに保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일치를 해제하면 파일은 제목 없이 그대로 내 소스에 남습니다. 일치 정보는 이 기기에 저장됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desassociar mantém o arquivo em Minhas fontes como está, sem título. As correspondências ficam salvas neste dispositivo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消匹配后，文件会以无标题的原样保留在“我的来源”中。匹配信息保存在此设备上。"
          }
        }
      }
    },
