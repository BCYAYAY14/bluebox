    "Install Infuse or VLC to open videos in another player. Bluebox finds the ones on this device.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Installiere Infuse oder VLC, um Videos in einem anderen Player zu öffnen. Bluebox findet die auf diesem Gerät."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instala Infuse o VLC para abrir los vídeos en otro reproductor. Bluebox encuentra los que hay en este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installez Infuse ou VLC pour ouvrir les vidéos dans un autre lecteur. Bluebox trouve ceux qui sont sur cet appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Installa Infuse o VLC per aprire i video in un altro player. Bluebox trova quelli presenti su questo dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別のプレーヤーで動画を開くには、InfuseまたはVLCをインストールしてください。Blueboxがこのデバイス上のプレーヤーを見つけます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 플레이어에서 동영상을 열려면 Infuse나 VLC를 설치하세요. Bluebox가 이 기기에 있는 플레이어를 찾습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Instale o Infuse ou o VLC para abrir vídeos em outro player. O Bluebox encontra os que estão neste dispositivo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安装 Infuse 或 VLC 即可在其他播放器中打开视频。Bluebox 会找到此设备上的播放器。"
          }
        }
      }
    },
    "Install and Relaunch": {
      "extractionState": "manual",
      "localizations": {
