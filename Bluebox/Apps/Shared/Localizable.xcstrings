          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El retraso del audio funciona cuando VLC reproduce el video (MKV y la mayoría de torrents). Este video se reproduce con AVPlayer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le décalage audio fonctionne quand VLC lit la vidéo (MKV et la plupart des torrents). Cette vidéo est lue avec AVPlayer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il ritardo audio funziona quando VLC riproduce il video (MKV e la maggior parte dei torrent). Questo video viene riprodotto con AVPlayer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オーディオの遅延は、VLCで再生している場合（MKVやほとんどのトレント）に使えます。このビデオはAVPlayerで再生されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오디오 지연은 VLC가 비디오를 재생할 때(MKV 및 대부분의 토렌트) 작동합니다. 이 비디오는 AVPlayer로 재생됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O atraso do áudio funciona quando o VLC reproduz o vídeo (MKV e a maioria dos torrents). Este vídeo é reproduzido com o AVPlayer."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 VLC 播放视频（MKV 和大多数种子）时，音频延迟才有效。此视频使用 AVPlayer 播放。"
          }
        }
      }
