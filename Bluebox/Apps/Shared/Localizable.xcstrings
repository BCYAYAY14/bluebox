    "Sync API Keys turns off. Your keys stay in each device's Keychain.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„API-Schlüssel synchronisieren“ wird ausgeschaltet. Deine Schlüssel bleiben im Schlüsselbund jedes Geräts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«Sincronizar claves de API» se desactiva. Tus claves se quedan en el llavero de cada dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Synchroniser les clés API » se désactive. Vos clés restent dans le Trousseau de chaque appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“Sincronizza chiavi API” si disattiva. Le tue chiavi restano nel Portachiavi di ogni dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「APIキーを同期」がオフになります。キーは各デバイスのキーチェーンに残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "API 키 동기화가 꺼집니다. 키는 각 기기의 키체인에 유지됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
