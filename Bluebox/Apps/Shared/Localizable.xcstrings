    "Leaves out [sounds], (sighs), ♪ lyrics and “NAME:” labels.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lässt [Geräusche], (seufzt), ♪ Liedtexte und „NAME:“-Hinweise weg."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Omite [sonidos], (suspiros), letras con ♪ y etiquetas de «NOMBRE:»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Omet les [sons], (soupirs), les paroles ♪ et les étiquettes « NOM : »."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Omette [suoni], (sospiri), ♪ testi e etichette “NOME:”."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "[効果音]、(ため息)、♪歌詞、「名前:」のラベルを除外します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "[소리], (한숨), ♪ 가사, “NAME:” 레이블을 제외합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Omite [sons], (suspiros), letras de ♪ e rótulos “NOME:”."
