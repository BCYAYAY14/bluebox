    "Lines from the video's own track appear as they're read.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeilen aus der eigenen Spur des Videos erscheinen, sobald sie gelesen werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las líneas de la pista del propio video aparecen a medida que se leen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les lignes de la piste propre à la vidéo apparaissent au fur et à mesure de leur lecture."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le righe della traccia del video compaiono man mano che vengono lette."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ビデオ自体のトラックの行は、読み取られるたびに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비디오 자체 트랙의 줄은 읽히는 대로 표시됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As linhas da faixa do próprio vídeo aparecem conforme são lidas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "视频自身轨道中的字幕行会在读取时显示。"
          }
        }
      }
    },
