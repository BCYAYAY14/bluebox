    "Match a Line and drift fixes need the lines themselves, so they work with subtitle files.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeilenabgleich und Korrektur von Abdriften brauchen die Zeilen selbst, daher funktionieren sie mit Untertiteldateien."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«Coincidir una línea» y las correcciones de desfase necesitan las propias líneas, así que funcionan con archivos de subtítulos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Faire correspondre une ligne » et la correction de dérive ont besoin des lignes elles-mêmes : elles fonctionnent donc avec des fichiers de sous-titres."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“Abbina una riga” e le correzioni della deriva richiedono le righe stesse, quindi funzionano con i file di sottotitoli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「行を指定して合わせる」とずれの補正には字幕の行そのものが必要なため、字幕ファイルで使用できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "줄 맞추기와 어긋남 보정에는 자막 줄 자체가 필요하므로 자막 파일에서 작동합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Combinar uma Linha e as correções de desvio precisam das próprias linhas, então funcionam com arquivos de legenda."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“匹配一行”和偏移修正需要字幕行本身，因此适用于字幕文件。"
          }
        }
      }
    },
