    "No torrents or debrid links on mobile data. Your own files and servers still play.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Torrents oder Debrid-Links über mobile Daten. Deine eigenen Dateien und Server laufen weiterhin."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin torrents ni enlaces debrid con datos móviles. Tus propios archivos y servidores siguen reproduciéndose."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de torrents ni de liens debrid en données mobiles. Vos propres fichiers et serveurs restent lisibles."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Niente torrent né link debrid con la rete cellulare. I tuoi file e server si riproducono comunque."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モバイルデータ通信ではトレントやデブリッドリンクは使えません。自分のファイルとサーバは引き続き再生できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모바일 데이터에서는 토렌트나 디브리드 링크를 사용할 수 없습니다. 내 파일과 서버는 계속 재생됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem torrents nem links debrid com dados móveis. Seus próprios arquivos e servidores continuam funcionando."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移动数据下不使用种子或 Debrid 链接。你自己的文件和服务器仍可播放。"
          }
        }
      }
    },
