    "Keep this look as a preset of your own": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diesen Stil als eigenes Preset sichern"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardar este estilo como un ajuste preestablecido propio"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserver ce style comme préréglage personnel"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserva questo aspetto come preset personale"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このスタイルを自分のプリセットとして保存します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 스타일을 나만의 프리셋으로 보관"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardar este visual como um preset seu"
          }
        },
        "zh-Hans": {
