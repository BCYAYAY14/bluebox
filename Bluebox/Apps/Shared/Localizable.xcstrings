            "value": "プリセット"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프리셋"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Presets"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "预设"
          }
        }
      }
    },
    "Presets are set up from your debrid service and release settings, so changing those updates them.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Presets werden aus deinem Debrid-Dienst und den Release-Einstellungen eingerichtet; wenn du diese änderst, werden sie aktualisiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los ajustes preestablecidos se configuran a partir de tu servicio debrid y de los ajustes de releases, así que cambiarlos los actualiza."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les préréglages sont définis à partir de votre service debrid et des réglages de release : les modifier les met à jour."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I preset si basano sul tuo servizio debrid e sulle impostazioni delle release, quindi modificarli li aggiorna."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プリセットはデブリッドサービスとリリースの設定に基づいて作成されるため、それらを変更すると更新されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프리셋은 디브리드 서비스와 릴리스 설정에서 만들어지므로 해당 설정을 변경하면 업데이트됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os presets são montados a partir do seu serviço debrid e dos ajustes de release, então alterá-los os atualiza."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "预设根据你的 Debrid 服务和资源设置建立，因此更改这些设置会更新预设。"
          }
        }
      }
    },
    "Press and hold + on any movie or show, or choose Add to List… from a poster's menu.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte bei einem Film oder einer Serie + gedrückt oder wähle im Menü eines Posters „Zur Liste hinzufügen …“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsado + en cualquier película o serie, o elige «Añadir a la lista…» en el menú de un póster."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez + sur un film ou une série, ou choisissez « Ajouter à la liste… » dans le menu d’une affiche."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuto + su un film o una serie, oppure scegli “Aggiungi alla lista…” dal menu di una locandina."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "映画や番組の＋を長押しするか、ポスターのメニューから「リストに追加…」を選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "영화나 프로그램에서 +를 길게 누르거나 포스터 메뉴에서 리스트에 추가…를 선택하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha pressionado + em qualquer filme ou série, ou escolha Adicionar à Lista… no menu de um pôster."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在任意电影或节目上按住 +，或从海报的菜单中选择“添加到列表…”。"
          }
        }
      }
    },
    "Press and hold the video to play at 2× for a moment.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte das Video gedrückt, um kurz mit 2× abzuspielen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsado el video para reproducirlo a 2× un momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez la vidéo appuyée pour lire à 2× un instant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuto il video per riprodurre a 2× per un momento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ビデオを長押しすると、しばらく2倍速で再生します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비디오를 길게 누르면 잠시 2배속으로 재생됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha o vídeo pressionado para reproduzir a 2× por um momento."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住视频可暂时以 2 倍速播放。"
          }
        }
      }
    },
