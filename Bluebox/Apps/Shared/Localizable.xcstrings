          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvindo neste dispositivo. Toque de novo para parar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在此设备上聆听。再次点按可停止。"
