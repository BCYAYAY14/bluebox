    "Trakt shows what you're watching as it plays, and adds it to your history when you finish.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Trakt zeigt, was du gerade schaust, und fügt es deinem Verlauf hinzu, wenn du fertig bist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Trakt muestra lo que estás viendo mientras se reproduce y lo añade a tu historial cuando terminas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trakt affiche ce que vous regardez pendant la lecture et l’ajoute à votre historique quand vous avez terminé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trakt mostra ciò che stai guardando durante la riproduzione e lo aggiunge alla tua cronologia quando finisci."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Traktは、再生中の作品を視聴中として表示し、視聴を完了すると履歴に追加します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Trakt는 재생되는 동안 시청 중인 콘텐츠를 표시하고, 끝까지 보면 기록에 추가합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Trakt mostra o que você está assistindo enquanto toca e adiciona ao seu histórico quando você termina."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Trakt 会在播放时显示你正在观看的内容，并在你看完时将其加入历史记录。"
          }
        }
      }
    },
