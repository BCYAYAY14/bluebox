          "stringUnit": {
            "state": "translated",
            "value": "番組をマイリストに追加するか、作品の「通知を受け取る」をタップすると、次のエピソードがここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
