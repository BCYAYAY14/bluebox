        }
      }
    },
    "Search Automatically: when a video has nothing in your language, Bluebox adds the best match from OpenSubtitles. Each counts toward your daily limit.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatisch suchen: Hat ein Video nichts in deiner Sprache, fügt Bluebox den besten Treffer von OpenSubtitles hinzu. Jeder zählt zu deinem Tageslimit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Buscar automáticamente: si un vídeo no tiene nada en tu idioma, Bluebox añade la mejor coincidencia de OpenSubtitles. Cada una cuenta para tu límite diario."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recherche automatique : quand une vidéo n’a rien dans votre langue, Bluebox ajoute la meilleure correspondance d’OpenSubtitles. Chacune compte dans votre limite quotidienne."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerca automaticamente: quando un video non ha nulla nella tua lingua, Bluebox aggiunge la corrispondenza migliore da OpenSubtitles. Ognuna conta nel tuo limite giornaliero."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動検索：ビデオに自分の言語の字幕がないとき、BlueboxがOpenSubtitlesから最適なものを追加します。それぞれ1日の上限に数えられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동 검색: 동영상에 내 언어의 자막이 없으면 Bluebox가 OpenSubtitles에서 가장 잘 맞는 것을 추가합니다. 각각 하루 한도에 포함됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Busca automática: quando um vídeo não tem nada no seu idioma, o Bluebox adiciona a melhor correspondência do OpenSubtitles. Cada uma conta no seu limite diário."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动搜索：当视频没有你的语言的字幕时，Bluebox 会添加 OpenSubtitles 上最匹配的字幕。每次都计入你的每日限额。"
          }
        }
      }
    },
