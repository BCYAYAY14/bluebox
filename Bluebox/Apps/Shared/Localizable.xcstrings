          }
        }
      }
    },
    "Their profile’s PIN opens Settings.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die PIN ihres Profils öffnet die Einstellungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El PIN de su perfil abre Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le code de son profil ouvre les Réglages."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il PIN del suo profilo apre le Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その人のプロフィールのPINで設定を開けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그 사람의 프로필 PIN으로 설정을 열 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O PIN do perfil dele abre os Ajustes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用其个人资料的 PIN 打开设置。"
          }
        }
      }
    },
