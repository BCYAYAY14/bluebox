            "state": "translated",
            "value": "Bluebox가 듣는 동안 자막이 변경되었습니다. 다시 시도하십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As legendas mudaram enquanto o Bluebox ouvia. Tente novamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluebox 收听时字幕已更改。请重试。"
          }
        }
      }
    },
    "The subtitles have no lines around here to match. Try again where there's dialogue.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Untertitel haben hier keine Zeilen zum Abgleichen. Versuche es an einer Stelle mit Dialog erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los subtítulos no tienen líneas en esta parte para comparar. Inténtalo donde haya diálogo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les sous-titres n’ont aucune ligne à comparer ici. Réessayez là où il y a des dialogues."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I sottotitoli non hanno righe da confrontare in questo punto. Riprova dove c’è dialogo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この付近には照合できる字幕の行がありません。会話のある場所でもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 부근에는 맞춰 볼 자막 줄이 없습니다. 대사가 있는 곳에서 다시 시도하십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As legendas não têm falas aqui para comparar. Tente novamente onde houver diálogo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此处附近没有可匹配的字幕行。请在有对白的地方重试。"
          }
        }
      }
    },
    "The titles stay on My List and your other lists.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
