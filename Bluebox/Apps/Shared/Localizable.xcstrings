    "This can't be undone. Your library, profiles, sources, downloads and keys stay.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das lässt sich nicht widerrufen. Deine Mediathek, Profile, Quellen, Downloads und Schlüssel bleiben erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto no se puede deshacer. Tu biblioteca, perfiles, fuentes, descargas y claves se conservan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette action est irréversible. Votre bibliothèque, vos profils, sources, téléchargements et clés sont conservés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non si può annullare. Libreria, profili, fonti, download e chiavi restano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この操作は取り消せません。ライブラリ、プロフィール、ソース、ダウンロード、キーは残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 동작은 취소할 수 없습니다. 보관함, 프로필, 소스, 다운로드, 키는 유지됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto não pode ser desfeito. Sua biblioteca, perfis, fontes, downloads e chaves permanecem."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此操作无法撤销。你的资料库、个人资料、片源、下载内容和密钥会保留。"
          }
        }
      }
    },
