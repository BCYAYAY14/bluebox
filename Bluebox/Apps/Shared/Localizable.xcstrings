    },
    "Torrents pick up again the next time you open Bluebox, unless you paused them.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Torrents werden beim nächsten Öffnen von Bluebox fortgesetzt, außer du hast sie pausiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los torrents se reanudan la próxima vez que abras Bluebox, a menos que los hayas pausado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les torrents reprennent à la prochaine ouverture de Bluebox, sauf si vous les avez mis en pause."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I torrent riprendono alla prossima apertura di Bluebox, a meno che tu non li abbia messi in pausa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一時停止していない限り、次にBlueboxを開いたときにトレントが再開されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "토렌트는 일시 정지하지 않은 경우 다음에 Bluebox를 열 때 다시 이어집니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os torrents continuam na próxima vez que você abrir o Bluebox, a menos que você os tenha pausado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下次打开 Bluebox 时，种子会继续，除非你已将其暂停。"
          }
        }
      }
    },
    "Torrents stream with libtorrent (rasterbar), used under its BSD licence, with Boost under the Boost Software License. See THIRD-PARTY-NOTICES.md.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Torrents streamen mit libtorrent (rasterbar), verwendet unter der BSD-Lizenz, mit Boost unter der Boost Software License. Siehe THIRD-PARTY-NOTICES.md."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los torrents se transmiten con libtorrent (rasterbar), usado bajo su licencia BSD, con Boost bajo la Boost Software License. Consulta THIRD-PARTY-NOTICES.md."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les torrents sont diffusés avec libtorrent (rasterbar), utilisé sous licence BSD, avec Boost sous la Boost Software License. Voir THIRD-PARTY-NOTICES.md."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I torrent vengono trasmessi con libtorrent (rasterbar), usato con licenza BSD, con Boost sotto la Boost Software License. Vedi THIRD-PARTY-NOTICES.md."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トレントのストリーミングには、libtorrent（rasterbar）をBSDライセンスで、BoostをBoost Software Licenseで使用しています。THIRD-PARTY-NOTICES.mdを参照してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "토렌트는 BSD 라이선스에 따라 사용되는 libtorrent(rasterbar)와 Boost Software License에 따라 사용되는 Boost로 스트리밍됩니다. THIRD-PARTY-NOTICES.md를 참조하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os torrents são transmitidos com a libtorrent (rasterbar), usada sob sua licença BSD, com o Boost sob a Boost Software License. Veja THIRD-PARTY-NOTICES.md."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "种子使用 libtorrent (rasterbar) 串流，依据其 BSD 许可证使用，Boost 依据 Boost Software License 使用。请参阅 THIRD-PARTY-NOTICES.md。"
