          }
        }
      }
    },
    "Keeps the next episodes downloaded on Wi‑Fi and, if you like, deletes the ones you've watched.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hält die nächsten Folgen über WLAN geladen und löscht auf Wunsch die bereits gesehenen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantiene descargados los próximos episodios con Wi‑Fi y, si quieres, elimina los que ya has visto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garde les prochains épisodes téléchargés en Wi‑Fi et, si vous le souhaitez, supprime ceux que vous avez vus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantiene scaricati i prossimi episodi con Wi‑Fi e, se vuoi, elimina quelli che hai guardato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi‑Fiで次のエピソードをダウンロードしておき、必要に応じて視聴済みのものを削除します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi‑Fi에서 다음 에피소드를 계속 다운로드해 두고, 원하면 시청한 에피소드는 삭제합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantém os próximos episódios baixados no Wi‑Fi e, se quiser, apaga os que você já assistiu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过无线局域网保持接下来的剧集已下载，并可按需删除你已看过的剧集。"
          }
        }
      }
    },
    "Kept on this device": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf diesem Gerät gespeichert"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se guarda en este dispositivo"
          }
        },
        "fr": {
