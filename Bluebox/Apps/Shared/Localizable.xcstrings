    "One script makes the tables and the rules that keep each account's data private.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Skript legt die Tabellen und die Regeln an, die die Daten jedes Accounts privat halten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un script crea las tablas y las reglas que mantienen privados los datos de cada cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un script crée les tables et les règles qui protègent les données de chaque compte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un solo script crea le tabelle e le regole che mantengono privati i dati di ogni account."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1つのスクリプトで、テーブルと、各アカウントのデータを非公開に保つルールが作成されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스크립트 하나로 테이블과 각 계정의 데이터를 비공개로 유지하는 규칙이 만들어집니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um script cria as tabelas e as regras que mantêm privados os dados de cada conta."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一个脚本即可创建表以及保持各账户数据私密的规则。"
          }
        }
      }
    },
    "Online": {
