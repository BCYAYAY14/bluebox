    "“Playable now” and “4K” go by your downloads, your debrid cloud, and releases found this session.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Jetzt abspielbar“ und „4K“ richten sich nach deinen Downloads, deiner Debrid-Cloud und den in dieser Sitzung gefundenen Releases."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«Reproducible ahora» y «4K» se basan en tus descargas, tu nube debrid y los releases encontrados en esta sesión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Lisible maintenant » et « 4K » se fondent sur vos téléchargements, votre cloud debrid et les releases trouvées durant cette session."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“Riproducibile ora” e “4K” dipendono dai tuoi download, dal tuo cloud debrid e dalle release trovate in questa sessione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「今すぐ再生可能」と「4K」は、ダウンロード、デブリッドクラウド、このセッションで見つかったリリースに基づきます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“지금 재생 가능”과 “4K”는 다운로드, 디브리드 클라우드, 이번 세션에서 찾은 릴리스를 기준으로 합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“Reproduzível agora” e “4K” seguem seus downloads, sua nuvem debrid e as releases encontradas nesta sessão."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“现可播放”和“4K”依据你的下载内容、Debrid 云端以及本次会话中找到的资源。"
          }
        }
      }
    },
    "“Where I Left Off” resumes anything watched for more than 30 seconds.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Wo ich war“ setzt alles fort, was länger als 30 Sekunden gesehen wurde."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«Donde lo dejé» reanuda cualquier cosa vista durante más de 30 segundos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Là où je me suis arrêté » reprend tout ce qui a été regardé plus de 30 secondes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“Dove ero rimasto” riprende qualsiasi cosa guardata per più di 30 secondi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「続きから」は、30秒以上視聴したものすべてを再開します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“이어보기 지점”은 30초 넘게 시청한 모든 콘텐츠를 이어서 재생합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“Onde Parei” retoma tudo o que foi assistido por mais de 30 segundos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“上次看到的位置”会继续观看超过 30 秒的任何内容。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
