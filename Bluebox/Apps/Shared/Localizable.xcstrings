    "Debrid links, direct links, torrents and downloads open in Infuse. For torrents and downloads, Bluebox keeps running in the background to serve the video, until Infuse has left it alone for 15 minutes.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Debrid-Links, direkte Links, Torrents und Downloads öffnen sich in Infuse. Bei Torrents und Downloads läuft Bluebox im Hintergrund weiter, um das Video bereitzustellen, bis Infuse es 15 Minuten lang nicht mehr nutzt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los enlaces debrid, los enlaces directos, los torrents y las descargas se abren en Infuse. Para torrents y descargas, Bluebox sigue ejecutándose en segundo plano para servir el video, hasta que Infuse lo deja de usar durante 15 minutos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les liens debrid, liens directs, torrents et téléchargements s’ouvrent dans Infuse. Pour les torrents et téléchargements, Bluebox continue de tourner en arrière-plan pour diffuser la vidéo, jusqu’à ce qu’Infuse n’y touche plus pendant 15 minutes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I link debrid, i link diretti, i torrent e i download si aprono in Infuse. Per torrent e download, Bluebox resta in esecuzione in background per trasmettere il video, finché Infuse non lo lascia inutilizzato per 15 minuti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デブリッドリンク、直接リンク、トレント、ダウンロードはInfuseで開きます。トレントとダウンロードでは、Infuseが15分間操作されなくなるまで、Blueboxがバックグラウンドで動作を続けてビデオを配信します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "디브리드 링크, 직접 링크, 토렌트, 다운로드가 Infuse에서 열립니다. 토렌트와 다운로드의 경우 Infuse가 15분 동안 사용하지 않을 때까지 Bluebox가 백그라운드에서 계속 실행되어 비디오를 제공합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Links debrid, links diretos, torrents e downloads abrem no Infuse. Para torrents e downloads, o Bluebox continua em segundo plano para transmitir o vídeo, até o Infuse ficar 15 minutos sem usá-lo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Debrid 链接、直接链接、种子和下载内容将在 Infuse 中打开。对于种子和下载内容，Bluebox 会在后台持续运行以提供视频，直到 Infuse 闲置 15 分钟为止。"
          }
        }
      }
    },
    "Debrid links, direct links, torrents and downloads open in Infuse; Bluebox keeps serving torrents while Infuse plays them.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Debrid-Links, direkte Links, Torrents und Downloads öffnen sich in Infuse; Bluebox liefert Torrents weiter aus, solange Infuse sie abspielt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los enlaces debrid, los enlaces directos, los torrents y las descargas se abren en Infuse; Bluebox sigue sirviendo torrents mientras Infuse los reproduce."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les liens debrid, liens directs, torrents et téléchargements s’ouvrent dans Infuse ; Bluebox continue de diffuser les torrents tant qu’Infuse les lit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I link debrid, i link diretti, i torrent e i download si aprono in Infuse; Bluebox continua a servire i torrent mentre Infuse li riproduce."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デブリッドリンク、直接リンク、トレント、ダウンロードはInfuseで開きます。Infuseがトレントを再生している間、Blueboxは配信を続けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "디브리드 링크, 직접 링크, 토렌트, 다운로드가 Infuse에서 열리며, Infuse가 재생하는 동안 Bluebox가 토렌트를 계속 제공합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Links debrid, links diretos, torrents e downloads abrem no Infuse; o Bluebox continua servindo os torrents enquanto o Infuse os reproduz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Debrid 链接、直接链接、种子和下载内容将在 Infuse 中打开；Infuse 播放种子时，Bluebox 会持续提供服务。"
          }
        }
      }
    },
