    "Nothing hidden. Choose Not Interested on a poster to keep it off Home.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts ausgeblendet. Wähle bei einem Poster „Kein Interesse“, um es vom Home fernzuhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada oculto. Elige «No me interesa» en un póster para quitarlo de Inicio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien de masqué. Choisissez « Pas intéressé » sur une affiche pour la garder hors de l’accueil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Niente di nascosto. Scegli “Non mi interessa” su una locandina per tenerla fuori da Home."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "非表示のものはありません。ポスターで「興味なし」を選ぶと、ホームに表示されなくなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "숨긴 항목이 없습니다. 홈에 표시하지 않으려면 포스터에서 관심 없음을 선택하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada oculto. Escolha Sem Interesse em um pôster para tirá-lo do Início."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有已隐藏的内容。在海报上选择“不感兴趣”可将其从主页中隐藏。"
          }
        }
      }
    },
