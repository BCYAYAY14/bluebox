          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour les boutons de saut et les touches fléchées d’un clavier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per i pulsanti di salto e i tasti freccia della tastiera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
