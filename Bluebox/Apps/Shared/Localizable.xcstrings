    "Copy it from the add-on's configure page, or from a device that has it. It's kept in this device's Keychain.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopiere ihn von der Konfigurationsseite des Add-ons oder von einem Gerät, das ihn hat. Er wird im Schlüsselbund dieses Geräts gespeichert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cópiala desde la página de configuración del add-on o desde un dispositivo que la tenga. Se guarda en el llavero de este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copiez-la depuis la page de configuration de l’add-on, ou depuis un appareil qui l’a. Elle est conservée dans le Trousseau de cet appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Copialo dalla pagina di configurazione dell’add-on, o da un dispositivo che lo ha. Viene conservato nel Portachiavi di questo dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アドオンの設定ページ、またはすでに設定済みのデバイスからコピーしてください。このデバイスのキーチェーンに保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "애드온의 구성 페이지나 이미 가지고 있는 기기에서 복사하세요. 이 기기의 키체인에 보관됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Copie da página de configuração do add-on ou de um dispositivo que a tenha. Ela fica nas Chaves deste dispositivo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从附加组件的配置页面，或从已有该密钥的设备拷贝。它保存在此设备的钥匙串中。"
          }
        }
      }
    },
