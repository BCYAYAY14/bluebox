          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor pidió iniciar sesión. Comprueba la cuenta en Ajustes › Fuentes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur a demandé une connexion. Vérifiez le compte dans Réglages › Sources."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il server ha richiesto un accesso. Controlla l’account in Impostazioni › Fonti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバからサインインを求められました。「設定 › ソース」でアカウントを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버에서 로그인을 요청했습니다. 설정 › 소스에서 계정을 확인하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor pediu um login. Verifique a conta em Ajustes › Fontes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器要求登录。请在“设置”›“片源”中检查该账户。"
          }
        }
      }
    },
    "The server didn't accept Bluebox's sign-in. Remove the source and add it again in Settings › Sources.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server hat die Anmeldung von Bluebox nicht akzeptiert. Entferne die Quelle und füge sie unter Einstellungen › Quellen erneut hinzu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor no aceptó el inicio de sesión de Bluebox. Quita la fuente y vuelve a añadirla en Ajustes › Fuentes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur n’a pas accepté la connexion de Bluebox. Retirez la source et ajoutez-la de nouveau dans Réglages › Sources."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il server non ha accettato l’accesso di Bluebox. Rimuovi la fonte e aggiungila di nuovo in Impostazioni › Fonti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバがBlueboxのサインインを受け付けませんでした。「設定 › ソース」でソースを削除して、もう一度追加してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버가 Bluebox의 로그인을 수락하지 않았습니다. 설정 › 소스에서 소스를 제거한 후 다시 추가하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor não aceitou o login do Bluebox. Remova a fonte e adicione-a de novo em Ajustes › Fontes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器未接受 Bluebox 的登录。请在“设置”›“片源”中移除该片源并重新添加。"
          }
        }
      }
    },
    "The server didn't accept that token.": {
