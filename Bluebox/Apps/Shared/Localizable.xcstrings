    "Films and episodes you finish appear here, by date, so you can find them again.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Filme und Folgen, die du fertig siehst, erscheinen hier nach Datum, damit du sie wiederfindest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las películas y los episodios que termines aparecen aquí, por fecha, para que puedas encontrarlos de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les films et épisodes que vous terminez apparaissent ici, par date, pour les retrouver facilement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Film e episodi che finisci compaiono qui, per data, così puoi ritrovarli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最後まで視聴した映画やエピソードが日付順にここに表示され、あとから見つけやすくなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "끝까지 본 영화와 에피소드가 날짜별로 여기에 표시되어 다시 찾을 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Filmes e episódios que você termina aparecem aqui, por data, para você encontrá-los de novo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你看完的电影和剧集会按日期显示在此，方便再次查找。"
          }
        }
      }
    },
    "Films and episodes you start show up here.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Filme und Folgen, die du beginnst, erscheinen hier."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las películas y los episodios que empieces aparecen aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les films et épisodes que vous commencez apparaissent ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Film e episodi che inizi compaiono qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "視聴を開始した映画やエピソードがここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시청을 시작한 영화와 에피소드가 여기에 표시됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Filmes e episódios que você começa aparecem aqui."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你开始观看的电影和剧集会显示在这里。"
          }
        }
      }
    },
    "Films and shows you download show up here.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Filme und Serien, die du lädst, erscheinen hier."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las películas y series que descargues aparecen aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les films et séries que vous téléchargez apparaissent ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Film e serie che scarichi compaiono qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダウンロードした映画や番組がここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다운로드한 영화와 프로그램이 여기에 표시됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Filmes e séries que você baixa aparecem aqui."
          }
        },
