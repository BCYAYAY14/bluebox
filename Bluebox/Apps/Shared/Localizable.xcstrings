    "Keep Bluebox open until it's done. If anything stops it, Try Again carries on from where it was.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lass Bluebox geöffnet, bis es fertig ist. Falls etwas es stoppt, macht „Erneut versuchen“ dort weiter, wo es war."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén Bluebox abierto hasta que termine. Si algo lo detiene, «Reintentar» continúa desde donde se quedó."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardez Bluebox ouvert jusqu’à la fin. Si quelque chose l’interrompt, « Réessayer » reprend là où il en était."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni Bluebox aperto finché non ha finito. Se qualcosa lo interrompe, “Riprova” riparte da dove era arrivato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完了するまでBlueboxを開いたままにしてください。中断された場合は、「再試行」で続きから再開します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "완료될 때까지 Bluebox를 열어 두세요. 중단되면 다시 시도를 눌러 중단된 지점부터 이어서 진행합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha o Bluebox aberto até terminar. Se algo interromper, Tentar de Novo continua de onde parou."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请保持 Bluebox 打开直到完成。如果有任何情况中断，“重试”会从中断处继续。"
          }
        }
      }
    },
    "Keep Downloading in the Background": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloads im Hintergrund fortsetzen"
          }
