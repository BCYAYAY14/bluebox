    "Torrentio, StremThru and Comet are one tap away; any other Stremio add-on can be added by its link.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Torrentio, StremThru und Comet sind nur einen Tipp entfernt; jedes andere Stremio-Add-on lässt sich per Link hinzufügen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Torrentio, StremThru y Comet están a un toque; cualquier otro add-on de Stremio se puede añadir con su enlace."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Torrentio, StremThru et Comet sont à portée de main ; tout autre add-on Stremio peut être ajouté par son lien."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Torrentio, StremThru e Comet sono a un tocco di distanza; qualsiasi altro add-on Stremio può essere aggiunto tramite il suo link."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Torrentio、StremThru、Cometはワンタップで追加できます。その他のStremioアドオンはリンクから追加できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Torrentio, StremThru, Comet은 한 번의 탭으로 추가할 수 있으며, 다른 Stremio 애드온은 링크로 추가할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Torrentio, StremThru e Comet estão a um toque; qualquer outro add-on do Stremio pode ser adicionado pelo link."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Torrentio、StremThru 和 Comet 一键即可添加；任何其他 Stremio 附加组件都可通过其链接添加。"
          }
        }
      }
    },
