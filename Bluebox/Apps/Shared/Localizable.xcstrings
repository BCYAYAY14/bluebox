    "Search lists what you searched for recently, with the top result's picture. Off: nothing new is remembered.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Suche listet auf, wonach du zuletzt gesucht hast, mit dem Bild des Top-Ergebnisses. Aus: Es wird nichts Neues gemerkt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Buscar muestra lo que has buscado recientemente, con la imagen del primer resultado. Desactivado: no se recuerda nada nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La recherche liste vos recherches récentes, avec l’image du premier résultat. Désactivé : rien de nouveau n’est mémorisé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La ricerca elenca ciò che hai cercato di recente, con l’immagine del primo risultato. Disattivata: non viene memorizzato nulla di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "検索には、最近検索した内容が一番上の結果の画像とともに表示されます。オフにすると、新しい検索は記憶されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "검색은 최근 검색한 항목을 상위 결과의 이미지와 함께 표시합니다. 끄면: 새로운 항목은 기억되지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Busca lista o que você pesquisou recentemente, com a imagem do primeiro resultado. Desativado: nada novo é lembrado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“搜索”会列出你最近搜索的内容及首个结果的图片。关：不记录任何新内容。"
          }
        }
      }
