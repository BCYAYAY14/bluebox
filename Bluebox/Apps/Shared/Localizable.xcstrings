    "Formats AVPlayer can't open play with libVLC through SwiftVLC, used under the GNU LGPL 2.1 or later.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Formate, die AVPlayer nicht öffnen kann, spielt libVLC über SwiftVLC ab, verwendet unter der GNU LGPL 2.1 oder neuer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los formatos que AVPlayer no puede abrir se reproducen con libVLC a través de SwiftVLC, utilizado bajo la licencia GNU LGPL 2.1 o posterior."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les formats qu’AVPlayer ne peut pas ouvrir sont lus avec libVLC via SwiftVLC, utilisé sous licence GNU LGPL 2.1 ou ultérieure."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I formati che AVPlayer non riesce ad aprire vengono riprodotti con libVLC tramite SwiftVLC, usato secondo la GNU LGPL 2.1 o successiva."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AVPlayerで開けない形式は、SwiftVLCを通じてlibVLCで再生されます（GNU LGPL 2.1以降に基づいて使用）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AVPlayer가 열 수 없는 형식은 GNU LGPL 2.1 이상에 따라 사용되는 SwiftVLC를 통해 libVLC로 재생됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Formatos que o AVPlayer não consegue abrir são reproduzidos com a libVLC por meio do SwiftVLC, usado sob a GNU LGPL 2.1 ou posterior."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AVPlayer 无法打开的格式将通过 SwiftVLC 使用 libVLC 播放，依据 GNU LGPL 2.1 或更高版本使用。"
          }
        }
      }
    },
