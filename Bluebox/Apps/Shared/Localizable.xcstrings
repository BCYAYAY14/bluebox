    "Release alerts will show here while Bluebox is open. Allow notifications in System Settings to get them otherwise.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Release-Hinweise erscheinen hier, solange Bluebox geöffnet ist. Erlaube Mitteilungen in den Systemeinstellungen, um sie sonst zu erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los avisos de estrenos aparecerán aquí mientras Bluebox esté abierto. Permite las notificaciones en Ajustes del Sistema para recibirlos en otro caso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les alertes de sortie s’afficheront ici tant que Bluebox est ouvert. Autorisez les notifications dans Réglages Système pour les recevoir autrement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli avvisi sulle release compariranno qui mentre Bluebox è aperto. Altrimenti consenti le notifiche in Impostazioni di Sistema per riceverli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リリース通知は、Blueboxを開いている間ここに表示されます。それ以外で受け取るには、システム設定で通知を許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluebox가 열려 있는 동안 릴리스 알림이 여기에 표시됩니다. 그렇지 않은 경우 알림을 받으려면 시스템 설정에서 알림을 허용하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os alertas de release aparecerão aqui enquanto o Bluebox estiver aberto. Permita notificações em Ajustes do Sistema para recebê-los de outra forma."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluebox 打开时，资源提醒会显示在这里。否则，请在“系统设置”中允许通知以接收提醒。"
          }
        }
      }
    },
