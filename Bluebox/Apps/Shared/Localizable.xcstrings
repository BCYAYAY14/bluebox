    "Voices before lips move: play the sound later. Lips before voices: earlier. Steps are in milliseconds.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stimmen vor den Lippenbewegungen: Spiele den Ton später ab. Lippen vor den Stimmen: früher. Die Schritte sind in Millisekunden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Voces antes que los labios: reproduce el sonido más tarde. Labios antes que las voces: antes. Los pasos son en milisegundos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voix avant les lèvres : lisez le son plus tard. Lèvres avant les voix : plus tôt. Les pas sont en millisecondes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Voci prima del movimento delle labbra: riproduci l’audio più tardi. Labbra prima delle voci: prima. I passi sono in millisecondi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "声が先で口が遅い場合は音を遅らせ、口が先で声が遅い場合は早めます。ステップはミリ秒単位です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "입 모양보다 목소리가 먼저면 소리를 늦추고, 입 모양이 먼저면 앞당기세요. 단위는 밀리초입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vozes antes dos lábios: reproduza o som mais tarde. Lábios antes das vozes: mais cedo. Os passos são em milissegundos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "声音先于口型：延后播放声音。口型先于声音：提前。步进单位为毫秒。"
          }
        }
      }
    },
