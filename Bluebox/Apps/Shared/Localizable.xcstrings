    "Then fill in the two boxes below and tap Connect.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fülle dann die beiden Felder unten aus und tippe auf „Verbinden“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Después rellena los dos campos de abajo y toca Conectar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remplissez ensuite les deux champs ci-dessous et touchez Connecter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Poi compila i due campi qui sotto e tocca Connetti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次に、下の2つのボックスに入力して「接続」をタップします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그런 다음 아래 두 칸을 채우고 연결을 탭하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Depois preencha as duas caixas abaixo e toque em Conectar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "然后填写下方的两个框并点按“连接”。"
          }
        }
      }
    },
    "Then tap to press it": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dann tippen, um es zu drücken"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Luego toca para pulsarlo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Puis touchez pour appuyer"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Poi tocca per premerlo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タップして押す"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그런 다음 탭하여 누르기"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Depois toque para pressionar"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "然后轻点以按下"
          }
        }
      }
    },
    "There aren't enough subtitle lines to match yet.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es gibt noch nicht genug Untertitelzeilen zum Abgleichen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay suficientes líneas de subtítulos para coincidir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n’y a pas encore assez de lignes de sous-titres à comparer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non ci sono ancora abbastanza righe di sottotitoli da abbinare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "照合できる字幕の行がまだ足りません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 맞출 자막 줄이 충분하지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há linhas de legenda suficientes para combinar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "字幕行数还不足以进行匹配。"
          }
        }
      }
    },
    "These follow the profile to your other devices.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese folgen dem Profil auf deine anderen Geräte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estos acompañan al perfil a tus otros dispositivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ils suivent le profil sur vos autres appareils."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questi seguono il profilo sugli altri tuoi dispositivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらはプロフィールとともに他のデバイスにも引き継がれます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 항목은 프로필과 함께 다른 기기로 이어집니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estes seguem o perfil para os seus outros dispositivos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些会随个人资料同步到你的其他设备。"
          }
        }
      }
    },
    "These shows only skip using the file's own chapters. Swipe to remove one and use community times again.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Serien überspringen nur anhand der Kapitel der Datei. Wische, um eine zu entfernen und wieder Community-Zeiten zu verwenden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas series solo omiten usando los capítulos del propio archivo. Desliza para quitar una y volver a usar los tiempos de la comunidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces séries ne passent que d’après les chapitres du fichier. Balayez pour en retirer une et réutiliser les repères de la communauté."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Queste serie saltano solo usando i capitoli del file. Scorri per rimuoverne una e usare di nuovo i tempi della community."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらの番組では、ファイル自体のチャプターのみを使ってスキップします。スワイプして削除すると、コミュニティの時間が再び使われます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 프로그램은 파일 자체의 챕터로만 건너뜁니다. 밀어서 제거하고 커뮤니티 타임스탬프를 다시 사용하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas séries só pulam usando os capítulos do próprio arquivo. Deslize para remover uma e usar os tempos da comunidade de novo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些节目仅使用文件自身的章节来跳过。轻扫可移除，并重新使用社区时间。"
          }
        }
      }
    },
    "These stay on this device: another device can't change what this one allows.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese bleiben auf diesem Gerät: Ein anderes Gerät kann nicht ändern, was dieses erlaubt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estos se quedan en este dispositivo: otro dispositivo no puede cambiar lo que este permite."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ils restent sur cet appareil : un autre appareil ne peut pas modifier ce que celui-ci autorise."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questi restano su questo dispositivo: un altro dispositivo non può cambiare ciò che questo consente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらはこのデバイスに保存されます。他のデバイスからこのデバイスの許可内容を変更することはできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 항목은 이 기기에 유지됩니다. 다른 기기에서는 이 기기에서 허용하는 항목을 변경할 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estes ficam neste dispositivo: outro dispositivo não pode alterar o que este permite."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些保留在此设备上：其他设备无法更改此设备的允许范围。"
          }
        }
      }
    },
