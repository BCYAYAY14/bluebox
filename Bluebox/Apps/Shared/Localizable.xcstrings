    "Showing the built-in sample catalog. Add a TMDB token in Settings for the full catalog.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der integrierte Beispielkatalog wird angezeigt. Füge in den Einstellungen ein TMDB-Token für den vollständigen Katalog hinzu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrando el catálogo de muestra integrado. Añade un token de TMDB en Ajustes para ver el catálogo completo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affichage du catalogue d’exemple intégré. Ajoutez un jeton TMDB dans les réglages pour le catalogue complet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Viene mostrato il catalogo di esempio integrato. Aggiungi un token TMDB in Impostazioni per il catalogo completo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "内蔵サンプルカタログを表示しています。すべてのカタログを利用するには、「設定」でTMDBトークンを追加してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내장 샘플 카탈로그를 표시하고 있습니다. 전체 카탈로그를 이용하려면 설정에서 TMDB 토큰을 추가하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
