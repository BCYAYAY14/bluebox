            "state": "translated",
            "value": "A Seguir"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "即将播放"
          }
        }
      }
    },
    "Up Next counts down, then plays the next episode.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Als Nächstes“ zählt herunter und spielt dann die nächste Folge ab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«Siguiente» cuenta atrás y luego reproduce el episodio siguiente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« À suivre » décompte, puis lit l’épisode suivant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“Prossimo episodio” conta alla rovescia, poi riproduce l’episodio successivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「次の作品」はカウントダウンしてから、次のエピソードを再生します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음 콘텐츠가 카운트다운한 후 다음 에피소드를 재생합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Seguir faz a contagem regressiva e então reproduz o próximo episódio."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“即将播放”倒数结束后会播放下一集。"
          }
        }
      }
    },
    "Up Next counts down, then plays the next episode. Off: playback stops when an episode ends.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Als Nächstes“ zählt herunter und spielt dann die nächste Folge. Aus: Die Wiedergabe stoppt am Ende einer Folge."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«A continuación» hace una cuenta atrás y reproduce el siguiente episodio. Desactivado: la reproducción se detiene al acabar un episodio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« À suivre » lance un compte à rebours, puis lit l’épisode suivant. Désactivé : la lecture s’arrête à la fin d’un épisode."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«Prossimo» fa il conto alla rovescia, poi riproduce l’episodio successivo. Disattivato: la riproduzione si ferma alla fine di un episodio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「次に再生」がカウントダウンしてから次のエピソードを再生します。オフ：エピソードが終わると再生を止めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음 재생이 카운트다운한 뒤 다음 에피소드를 재생합니다. 끔: 에피소드가 끝나면 재생이 멈춥니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O «A seguir» faz uma contagem e toca o próximo episódio. Desativado: a reprodução para quando um episódio termina."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“接下来播放”倒数后播放下一集。关闭：一集结束时停止播放。"
          }
        }
      }
    },
    "Up next": {
      "extractionState": "manual",
