    },
    "The server sent an empty or broken answer. Try again later.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server hat eine leere oder fehlerhafte Antwort gesendet. Versuche es später erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor envió una respuesta vacía o dañada. Inténtalo de nuevo más tarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur a envoyé une réponse vide ou corrompue. Réessayez plus tard."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il server ha inviato una risposta vuota o danneggiata. Riprova più tardi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバから空または壊れた応答が返されました。しばらくしてからもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버가 비어 있거나 손상된 응답을 보냈습니다. 나중에 다시 시도하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor enviou uma resposta vazia ou corrompida. Tente de novo mais tarde."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器返回了空的或损坏的响应。请稍后重试。"
          }
        }
      }
    },
    "The server sent something Bluebox couldn't read. Try again later.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server hat etwas gesendet, das Bluebox nicht lesen konnte. Versuche es später erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor envió algo que Bluebox no pudo leer. Inténtalo de nuevo más tarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur a envoyé quelque chose que Bluebox n’a pas pu lire. Réessayez plus tard."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il server ha inviato qualcosa che Bluebox non è riuscito a leggere. Riprova più tardi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバからBlueboxで読み取れない応答が返されました。しばらくしてからもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버가 Bluebox에서 읽을 수 없는 응답을 보냈습니다. 나중에 다시 시도하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor enviou algo que o Bluebox não conseguiu ler. Tente de novo mais tarde."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器返回了 Bluebox 无法读取的内容。请稍后重试。"
          }
        }
      }
    },
    "The server took too long to answer. Check your connection and try again.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server hat zu lange für die Antwort gebraucht. Prüfe deine Verbindung und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor tardó demasiado en responder. Comprueba tu conexión e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur a mis trop de temps à répondre. Vérifiez votre connexion et réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il server ha impiegato troppo tempo a rispondere. Controlla la connessione e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバの応答に時間がかかりすぎました。接続を確認して、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버 응답 시간이 너무 오래 걸렸습니다. 연결 상태를 확인한 다음 다시 시도하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor demorou demais para responder. Verifique sua conexão e tente de novo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器响应时间过长。请检查网络连接，然后重试。"
          }
        }
      }
    },
    "The speech didn't match these subtitles well enough. Are they for this video, and in this language?": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sprache passte nicht gut genug zu diesen Untertiteln. Gehören sie zu diesem Video und sind sie in dieser Sprache?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La voz no coincidió lo bastante con estos subtítulos. ¿Son de este video y de este idioma?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La voix ne correspondait pas assez à ces sous-titres. Sont-ils bien ceux de cette vidéo, et dans cette langue ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il parlato non corrispondeva abbastanza a questi sottotitoli. Sono per questo video e in questa lingua?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声がこれらの字幕と十分に一致しませんでした。このビデオ用で、この言語の字幕ですか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음성이 이 자막과 충분히 일치하지 않았습니다. 이 비디오의 자막이며 같은 언어인가요?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A fala não correspondeu bem o bastante a estas legendas. Elas são deste vídeo e neste idioma?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "语音与这些字幕匹配度不够。它们是否适用于此视频，且语言正确？"
          }
        }
      }
    },
    "The stream server only listens on this device. Change the StremThru server only if you host your own.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Stream-Server hört nur auf diesem Gerät zu. Ändere den StremThru-Server nur, wenn du einen eigenen hostest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor de transmisión solo escucha en este dispositivo. Cambia el servidor de StremThru solo si alojas el tuyo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur de flux n’écoute que sur cet appareil. Ne modifiez le serveur StremThru que si vous hébergez le vôtre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il server degli stream ascolta solo su questo dispositivo. Cambia il server StremThru solo se ne ospiti uno tuo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ストリームサーバはこのデバイスでのみ待ち受けます。StremThruサーバは、自分でホストする場合のみ変更してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스트림 서버는 이 기기에서만 수신합니다. 직접 호스팅하는 경우에만 StremThru 서버를 변경하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor de streams só escuta neste dispositivo. Altere o servidor StremThru somente se você hospeda o seu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "串流服务器仅在此设备上监听。仅当你自行托管时才更改 StremThru 服务器。"
          }
        }
      }
    },
    "The subtitles changed while Bluebox was listening. Try again.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Untertitel haben sich geändert, während Bluebox zugehört hat. Versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los subtítulos cambiaron mientras Bluebox escuchaba. Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les sous-titres ont changé pendant que Bluebox écoutait. Réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I sottotitoli sono cambiati mentre Bluebox ascoltava. Riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
