    "Positive values show subtitles later. Fine-tune one video in the player with [ and ].": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Positive Werte zeigen Untertitel später. Feinabstimmung für ein Video im Player mit [ und ]."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los valores positivos muestran los subtítulos más tarde. Ajusta con precisión un video en el reproductor con [ y ]."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les valeurs positives retardent les sous-titres. Ajustez finement une vidéo dans le lecteur avec [ et ]."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I valori positivi mostrano i sottotitoli più tardi. Regola un singolo video nel lettore con [ e ]."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "正の値にすると字幕が遅れて表示されます。1本のビデオを微調整するには、プレーヤーで[と]を使います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "양수 값은 자막을 더 늦게 표시합니다. 플레이어에서 [ 및 ]로 비디오별로 미세 조정하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Valores positivos mostram as legendas mais tarde. Ajuste um vídeo no player com [ e ]."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正值会使字幕延后显示。可在播放器中用 [ 和 ] 微调单个视频。"
          }
        }
      }
    },
    "Posters and backdrops download again as you browse.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Poster und Hintergründe werden beim Entdecken erneut geladen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los pósteres y fondos se vuelven a descargar mientras exploras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les affiches et images de fond se retéléchargent au fil de votre navigation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Locandine e sfondi vengono scaricati di nuovo mentre sfogli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ポスターと背景画像は、ブラウズすると再びダウンロードされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
