    "Titles on your lists that a source offers in 4K show up here once Bluebox has seen the release.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Titel in deinen Listen, die eine Quelle in 4K anbietet, erscheinen hier, sobald Bluebox das Release gesehen hat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los títulos de tus listas que una fuente ofrece en 4K aparecen aquí una vez que Bluebox ha visto el release."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les titres de vos listes qu’une source propose en 4K apparaissent ici dès que Bluebox a vu la release."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I titoli nelle tue liste che una fonte offre in 4K compaiono qui quando Bluebox ha visto la release."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リストにあるタイトルのうち、ソースが4Kで提供するものは、Blueboxがそのリリースを確認するとここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "리스트에 있는 작품 중 소스에서 4K로 제공하는 것은 Bluebox가 릴리스를 확인하면 여기에 표시됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Títulos das suas listas que uma fonte oferece em 4K aparecem aqui assim que o Bluebox vê a release."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你列表中的标题，一旦 Bluebox 发现片源提供 4K 资源，就会显示在这里。"
          }
        }
      }
    },
    "Titles you've hidden from Home's recommendations.": {
