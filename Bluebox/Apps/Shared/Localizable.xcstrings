    "Starts when you press Start. Others can still join later.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beginnt, wenn du auf „Start“ drückst. Andere können auch später noch beitreten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empieza cuando pulses Empezar. Otros pueden unirse más tarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Démarre quand vous appuyez sur Démarrer. D’autres peuvent encore rejoindre plus tard."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inizia quando premi Inizia. Gli altri possono unirsi anche dopo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「開始」を押すと始まります。あとから参加することもできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시작을 누르면 시작됩니다. 다른 사람은 나중에도 참여할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Começa quando você tocar em Começar. Outros ainda podem entrar depois."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按下“开始”即开始。其他人之后仍可加入。"
          }
        }
      }
    },
