{
  "sourceLanguage": "en",
  "strings": {
    "%@ next time Bluebox opens": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ beim nächsten Öffnen von Bluebox"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ la próxima vez que se abra Bluebox"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ à la prochaine ouverture de Bluebox"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ alla prossima apertura di Bluebox"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次回Blueboxを開いたときに%@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음에 Bluebox를 열 때 %@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ na próxima vez que o Bluebox abrir"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下次打开 Bluebox 时使用%@"
          }
        }
      }
    },
    "1 change hasn't uploaded": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "1 Änderung wurde nicht hochgeladen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "1 cambio no se ha subido"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "1 modification n’a pas été envoyée"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "1 modifica non è stata caricata"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1件の変更がアップロードされていません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "변경 사항 1개가 업로드되지 않음"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "1 alteração não foi enviada"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有 1 项更改尚未上传"
          }
        }
      }
    },
    "1 day left": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch 1 Tag"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Queda 1 día"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "1 jour restant"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Manca 1 giorno"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "残り1日"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "1일 남음"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Falta 1 dia"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "剩余 1 天"
          }
        }
      }
    },
    "A Bluebox server": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Bluebox-Server"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un servidor de Bluebox"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un serveur Bluebox"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un server Bluebox"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Blueboxサーバ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluebox 서버"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um servidor Bluebox"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一台 Bluebox 服务器"
          }
        }
      }
    },
    "A code works only with a Bluebox server set up in Settings › Account & Sync. Ask for the link instead.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Code funktioniert nur mit einem Bluebox-Server, der unter „Einstellungen › Account & Sync“ eingerichtet ist. Frag stattdessen nach dem Link."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un código solo funciona con un servidor de Bluebox configurado en Ajustes › Cuenta y sincronización. Pide el enlace en su lugar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un code ne fonctionne qu’avec un serveur Bluebox configuré dans Réglages › Compte et synchro. Demandez plutôt le lien."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un codice funziona solo con un server Bluebox configurato in Impostazioni › Account e sincronizzazione. Chiedi invece il link."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コードは「設定」›「アカウントと同期」で設定したBlueboxサーバでのみ使えます。代わりにリンクを頼んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "코드는 설정 › 계정 및 동기화에서 설정한 Bluebox 서버에서만 작동합니다. 대신 링크를 요청하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um código só funciona com um servidor Bluebox configurado em Ajustes › Conta e sincronização. Peça o link em vez disso."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "代码仅适用于在“设置 › 账户与同步”中设置的 Bluebox 服务器。请改为索要链接。"
          }
        }
      }
    },
    "A copy of another length": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Kopie mit anderer Länge"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una copia de otra duración"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une copie d’une autre durée"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una copia di durata diversa"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "長さの異なるコピー"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "길이가 다른 사본"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma cópia de outra duração"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "时长不同的副本"
          }
        }
      }
    },
    "A debrid service fetches torrents for you and streams them over HTTPS, so playback starts at once.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Debrid-Dienst lädt Torrents für dich und streamt sie über HTTPS, sodass die Wiedergabe sofort startet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un servicio debrid descarga los torrents por ti y los transmite por HTTPS, así que la reproducción empieza al instante."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un service debrid récupère les torrents pour vous et les diffuse en HTTPS : la lecture démarre aussitôt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un servizio debrid scarica i torrent per te e li trasmette in HTTPS, così la riproduzione parte subito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デブリッドサービスがトレントを取得し、HTTPSでストリーミングするため、すぐに再生が始まります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "디브리드 서비스는 사용자를 대신해 토렌트를 가져와 HTTPS로 스트리밍하므로 재생이 바로 시작됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um serviço debrid baixa os torrents para você e os transmite por HTTPS, então a reprodução começa na hora."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Debrid 服务会为你获取种子并通过 HTTPS 串流，因此可立即开始播放。"
          }
        }
      }
    },
    "A different copy. Bluebox checks it lines up when it opens.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine andere Kopie. Bluebox prüft beim Öffnen, ob sie synchron läuft."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una copia distinta. Bluebox comprueba que coincida al abrirla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une autre copie. Bluebox vérifie qu’elle est synchronisée à l’ouverture."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una copia diversa. Bluebox controlla che sia sincronizzata all’apertura."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別のコピーです。開いたときに Bluebox が同期を確認します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 사본입니다. 열 때 Bluebox가 동기화를 확인합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma cópia diferente. O Bluebox confere se ela fica sincronizada ao abrir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "另一个副本。打开时 Bluebox 会检查它是否同步。"
          }
        }
      }
    },
    "A free Supabase project holds your list and progress. Only you can see it.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein kostenloses Supabase-Projekt speichert deine Liste und deinen Fortschritt. Nur du kannst sie sehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un proyecto gratuito de Supabase guarda tu lista y tu progreso. Solo tú puedes verlos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un projet Supabase gratuit conserve votre liste et votre progression. Vous seul pouvez les voir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un progetto Supabase gratuito conserva la tua lista e i progressi. Solo tu puoi vederli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無料のSupabaseプロジェクトにリストと進行状況が保存されます。自分だけが見られます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무료 Supabase 프로젝트에 목록과 진행 상황이 저장됩니다. 본인만 볼 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um projeto Supabase gratuito guarda sua lista e seu progresso. Só você pode ver."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "免费的 Supabase 项目会保存你的列表和进度，只有你能看到。"
          }
        }
      }
    },
    "A free key from omdbapi.com adds IMDb, Rotten Tomatoes and Metacritic scores to title pages. Keys stay in your Keychain.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein kostenloser Schlüssel von omdbapi.com ergänzt Titelseiten um Bewertungen von IMDb, Rotten Tomatoes und Metacritic. Schlüssel bleiben in deinem Schlüsselbund."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una clave gratuita de omdbapi.com añade las puntuaciones de IMDb, Rotten Tomatoes y Metacritic a las páginas de los títulos. Las claves se guardan en tu llavero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une clé gratuite d’omdbapi.com ajoute les notes IMDb, Rotten Tomatoes et Metacritic aux pages des titres. Les clés restent dans votre Trousseau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una chiave gratuita di omdbapi.com aggiunge alle pagine dei titoli i voti di IMDb, Rotten Tomatoes e Metacritic. Le chiavi restano nel tuo Portachiavi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "omdbapi.comの無料キーを使うと、タイトルのページにIMDb、Rotten Tomatoes、Metacriticのスコアが表示されます。キーはキーチェーンに保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "omdbapi.com의 무료 키를 추가하면 작품 페이지에 IMDb, Rotten Tomatoes, Metacritic 점수가 표시됩니다. 키는 키체인에 보관됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma chave gratuita de omdbapi.com adiciona as notas do IMDb, Rotten Tomatoes e Metacritic às páginas dos títulos. As chaves ficam nas suas Chaves."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "来自 omdbapi.com 的免费密钥可在标题页面添加 IMDb、烂番茄和 Metacritic 评分。密钥保存在你的钥匙串中。"
          }
        }
      }
    },
    "A magnet link or .torrent file for something you have the right to watch. It downloads in order, so you can start watching at once. Bluebox never searches for torrents.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Magnet-Link oder eine .torrent-Datei für etwas, das du sehen darfst. Der Download erfolgt der Reihe nach, sodass du sofort losschauen kannst. Bluebox sucht nie nach Torrents."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un enlace magnet o un archivo .torrent de algo que tienes derecho a ver. Se descarga en orden, así que puedes empezar a verlo al instante. Bluebox nunca busca torrents."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un lien magnet ou un fichier .torrent d’un contenu que vous avez le droit de regarder. Il se télécharge dans l’ordre : vous pouvez commencer à regarder tout de suite. Bluebox ne recherche jamais de torrents."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un link magnet o un file .torrent di qualcosa che hai il diritto di guardare. Si scarica in ordine, quindi puoi iniziare a guardare subito. Bluebox non cerca mai torrent."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "視聴する権利のある作品のマグネットリンクまたは.torrentファイル。順番にダウンロードされるので、すぐに視聴を始められます。Bluebox自体がトレントを検索することはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시청 권한이 있는 콘텐츠의 마그넷 링크 또는 .torrent 파일입니다. 순서대로 다운로드되므로 바로 시청을 시작할 수 있습니다. Bluebox는 토렌트를 검색하지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um link magnet ou arquivo .torrent de algo que você tem o direito de assistir. Ele baixa em ordem, para você começar a assistir na hora. O Bluebox nunca procura torrents."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你有权观看的内容的磁力链接或 .torrent 文件。它会按顺序下载，因此可以立即开始观看。Bluebox 绝不会搜索种子。"
          }
        }
      }
    },
    "A party meets on your Bluebox server. Set one up in Settings › Account & Sync, then start the party again.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Party trifft sich auf deinem Bluebox-Server. Richte einen unter „Einstellungen › Account & Sync“ ein und starte die Party dann erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una fiesta se reúne en tu servidor de Bluebox. Configura uno en Ajustes › Cuenta y sincronización y vuelve a iniciar la fiesta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une soirée se tient sur votre serveur Bluebox. Configurez-en un dans Réglages › Compte et synchro, puis relancez la soirée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un party si riunisce sul tuo server Bluebox. Configurane uno in Impostazioni › Account e sincronizzazione, poi avvia di nuovo il party."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パーティはBlueboxサーバ上で開かれます。「設定」›「アカウントと同期」でサーバを設定してから、もう一度パーティを始めてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파티는 Bluebox 서버에서 열립니다. 설정 › 계정 및 동기화에서 서버를 설정한 다음 파티를 다시 시작하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma festa acontece no seu servidor Bluebox. Configure um em Ajustes › Conta e sincronização e inicie a festa de novo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "派对在你的 Bluebox 服务器上进行。请在“设置 › 账户与同步”中设置一个服务器，然后重新开始派对。"
          }
        }
      }
    },
    "A personal movie and TV player for your own sources: add-ons, torrents, debrid services, Jellyfin and your files.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein persönlicher Film- und Serienplayer für deine eigenen Quellen: Add-ons, Torrents, Debrid-Dienste, Jellyfin und deine Dateien."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un reproductor personal de películas y series para tus propias fuentes: add-ons, torrents, servicios debrid, Jellyfin y tus archivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un lecteur personnel de films et séries pour vos propres sources : add-ons, torrents, services debrid, Jellyfin et vos fichiers."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un lettore personale di film e serie TV per le tue fonti: add-on, torrent, servizi debrid, Jellyfin e i tuoi file."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アドオン、トレント、デブリッドサービス、Jellyfin、自分のファイルなど、自分のソースで楽しむ個人用の映画・TVプレーヤー。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "나만의 소스를 위한 개인용 영화 및 TV 플레이어: 애드온, 토렌트, 디브리드 서비스, Jellyfin, 내 파일."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um player pessoal de filmes e séries para as suas próprias fontes: add-ons, torrents, serviços debrid, Jellyfin e seus arquivos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "适用于你自己片源的个人电影和电视播放器：附加组件、种子、Debrid 服务、Jellyfin 和你的文件。"
          }
        }
      }
    },
    "A preset sets the font, size, colour, outline and box. Save Current keeps your own look; right-click or long-press it to rename or delete it.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Preset legt Schrift, Größe, Farbe, Kontur und Hintergrundbox fest. „Aktuelles sichern“ behält deinen eigenen Stil; mit Rechtsklick oder langem Drücken kannst du ihn umbenennen oder löschen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un ajuste preestablecido define la tipografía, el tamaño, el color, el contorno y el recuadro. «Guardar actual» conserva tu propio estilo; haz clic derecho o mantén pulsado para renombrarlo o eliminarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un préréglage définit la police, la taille, la couleur, le contour et le fond. « Enregistrer l’actuel » conserve votre style ; faites un clic droit ou un appui long dessus pour le renommer ou le supprimer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un preset imposta font, dimensione, colore, contorno e riquadro. “Salva attuale” conserva il tuo stile; fai clic con il tasto destro o tieni premuto per rinominarlo o eliminarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プリセットでは、フォント、サイズ、カラー、縁取り、背景ボックスをまとめて設定します。「現在の設定を保存」で自分のスタイルを保存できます。右クリックまたは長押しで名前の変更や削除ができます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프리셋은 글꼴, 크기, 색상, 윤곽선, 상자를 한 번에 설정합니다. 현재 설정 저장을 누르면 나만의 스타일이 보관되며, 우클릭하거나 길게 누르면 이름을 변경하거나 삭제할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um preset define fonte, tamanho, cor, contorno e caixa. “Salvar Atual” guarda o seu visual; clique com o botão direito ou mantenha pressionado para renomear ou apagar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "预设包含字体、大小、颜色、描边和背景框。“存储当前样式”会保留你自己的外观；右键点按或长按可重命名或删除。"
          }
        }
      }
    },
    "A same-length copy, not the host's exact one. It should stay in step.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Kopie gleicher Länge, nicht genau die des Gastgebers. Sie sollte synchron bleiben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una copia de la misma duración, no la exacta del anfitrión. Debería ir sincronizada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une copie de même durée, pas exactement celle de l’hôte. Elle devrait rester synchronisée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una copia della stessa durata, non esattamente quella dell’host. Dovrebbe restare sincronizzata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じ長さのコピーで、ホストのものとは異なります。同期は保たれるはずです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "같은 길이의 사본이지만 호스트의 것과 정확히 같지는 않습니다. 동기화는 유지될 것입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma cópia da mesma duração, não a exata do anfitrião. Ela deve ficar sincronizada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "时长相同的副本，但不是主持人的那一份。应该能保持同步。"
          }
        }
      }
    },
    "A second line comes from a subtitle file, or a plain text track in an MKV. Add or download a file in another language.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine zweite Zeile stammt aus einer Untertiteldatei oder einer reinen Text-Spur in einer MKV. Füge eine Datei in einer anderen Sprache hinzu oder lade sie herunter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una segunda línea procede de un archivo de subtítulos o de una pista de texto sin formato en un MKV. Añade o descarga un archivo en otro idioma."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une deuxième ligne provient d’un fichier de sous-titres ou d’une piste texte d’un MKV. Ajoutez ou téléchargez un fichier dans une autre langue."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una seconda riga proviene da un file di sottotitoli o da una traccia di testo semplice in un MKV. Aggiungi o scarica un file in un’altra lingua."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2行目には、字幕ファイルまたはMKV内のテキストトラックが使われます。別の言語のファイルを追加またはダウンロードしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두 번째 줄은 자막 파일 또는 MKV의 일반 텍스트 트랙에서 가져옵니다. 다른 언어의 파일을 추가하거나 다운로드하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma segunda linha vem de um arquivo de legenda ou de uma faixa de texto simples em um MKV. Adicione ou baixe um arquivo em outro idioma."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "第二行来自字幕文件，或 MKV 中的纯文本轨道。请添加或下载其他语言的文件。"
          }
        }
      }
    },
    "A set. Press L again at B.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "A gesetzt. Drücke bei B erneut L."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un conjunto. Pulsa L de nuevo en B."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un ensemble. Appuyez de nouveau sur L à B."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "A impostato. Premi di nuovo L su B."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Aを設定しました。Bでもう一度Lを押してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "A 지점. B 지점에서 L을 다시 누르세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
