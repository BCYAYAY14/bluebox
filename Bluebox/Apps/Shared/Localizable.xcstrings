    "Artwork, catalog data, downloaded subtitles and kept streams are deleted. Downloads stay.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Artwork, Katalogdaten, geladene Untertitel und behaltene Streams werden gelöscht. Downloads bleiben erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminan las carátulas, los datos del catálogo, los subtítulos descargados y las transmisiones guardadas. Las descargas se conservan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les illustrations, données du catalogue, sous-titres téléchargés et flux conservés sont supprimés. Les téléchargements sont conservés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Locandine, dati del catalogo, sottotitoli scaricati e stream conservati vengono eliminati. I download restano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アートワーク、カタログデータ、ダウンロードした字幕、保持したストリームが削除されます。ダウンロードしたものは削除されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아트워크, 카탈로그 데이터, 다운로드한 자막, 보관한 스트림이 삭제됩니다. 다운로드한 항목은 유지됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arte, dados do catálogo, legendas baixadas e streams guardados serão apagados. Os downloads permanecem."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "海报图、目录数据、已下载的字幕和保留的串流将被删除。下载内容会保留。"
          }
        }
      }
    },
