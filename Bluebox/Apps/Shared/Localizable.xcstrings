        }
      }
    },
    "Peer-to-peer is off on mobile data": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Peer-to-Peer ist bei mobilen Daten aus"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El peer-to-peer está desactivado con datos móviles"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le pair à pair est désactivé en données mobiles"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il peer-to-peer è disattivato con la rete cellulare"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モバイルデータ通信ではピアツーピアはオフです"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모바일 데이터에서 P2P 꺼짐"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O peer-to-peer está desativado com dados móveis"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移动数据下已关闭点对点"
          }
        }
      }
    },
    "Peer-to-peer streams use more data than debrid links, and share with other peers while they play. Choose Debrid Only to avoid uploading.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Peer-to-Peer-Streams brauchen mehr Daten als Debrid-Links und teilen während der Wiedergabe mit anderen Peers. Wähle „Nur Debrid“, um kein Hochladen zu verursachen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las transmisiones peer-to-peer usan más datos que los enlaces debrid y comparten con otros pares mientras se reproducen. Elige «Solo debrid» para evitar subir contenido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les flux pair à pair consomment plus de données que les liens debrid et partagent avec d’autres pairs pendant la lecture. Choisissez « Debrid uniquement » pour éviter l’envoi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli stream peer-to-peer usano più dati dei link debrid e condividono con altri peer mentre si riproducono. Scegli “Solo debrid” per evitare l’upload."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ピアツーピアのストリームはデブリッドリンクよりデータ通信量が多く、再生中に他のピアと共有します。アップロードを避けるには「デブリッドのみ」を選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "P2P 스트림은 디브리드 링크보다 데이터를 더 많이 사용하며 재생하는 동안 다른 피어와 공유합니다. 업로드를 피하려면 디브리드만을 선택하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Streams peer-to-peer usam mais dados que links debrid e compartilham com outros peers enquanto tocam. Escolha Somente Debrid para evitar uploads."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点对点串流比 Debrid 链接使用更多流量，且播放时会与其他对等节点共享。选择“仅 Debrid”可避免上传。"
          }
        }
      }
    },
