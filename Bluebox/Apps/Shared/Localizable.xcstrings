        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los torrents aún no se pueden transmitir aquí, así que solo se reproducen enlaces debrid. Configura un servicio debrid abajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les torrents ne peuvent pas encore être diffusés ici : seuls les liens debrid sont lus. Configurez un service debrid ci-dessous."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qui i torrent non possono ancora essere trasmessi, quindi si riproducono solo i link debrid. Configura un servizio debrid qui sotto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここではまだトレントをストリーミングできないため、デブリッドリンクのみ再生できます。下でデブリッドサービスを設定してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 여기서는 토렌트를 스트리밍할 수 없으므로 디브리드 링크만 재생됩니다. 아래에서 디브리드 서비스를 설정하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os torrents ainda não podem ser transmitidos aqui, então só links debrid são reproduzidos. Configure um serviço debrid abaixo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "种子暂时无法在此串流，因此只能播放 Debrid 链接。请在下方设置 Debrid 服务。"
          }
        }
      }
    },
    "Torrents don't download on mobile data.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Torrents werden nicht über mobile Daten geladen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los torrents no se descargan con datos móviles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les torrents ne se téléchargent pas en données mobiles."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I torrent non si scaricano con la rete cellulare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トレントはモバイルデータ通信ではダウンロードされません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "토렌트는 모바일 데이터로 다운로드되지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Torrents não são baixados com dados móveis."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移动数据下不下载种子。"
          }
        }
      }
    },
    "Torrents keep downloading after you leave Bluebox, which uses more battery.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Torrents werden auch nach dem Verlassen von Bluebox weitergeladen, was mehr Akku verbraucht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los torrents siguen descargándose cuando sales de Bluebox, lo que consume más batería."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les torrents continuent de se télécharger quand vous quittez Bluebox, ce qui consomme plus de batterie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I torrent continuano a scaricare dopo che esci da Bluebox, il che consuma più batteria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Blueboxを離れてもトレントのダウンロードが続くため、バッテリーの消費が増えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluebox를 떠난 후에도 토렌트가 계속 다운로드되어 배터리를 더 많이 사용합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os torrents continuam baixando depois que você sai do Bluebox, o que gasta mais bateria."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你离开 Bluebox 后种子会继续下载，这会消耗更多电量。"
          }
        }
      }
    },
