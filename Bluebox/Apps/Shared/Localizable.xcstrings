    "Add more with a title's Play ▾ or right-click › Add to Party Queue.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge mehr über das ▾ neben „Abspielen“ eines Titels oder per Rechtsklick › „Zur Party-Warteschlange hinzufügen“ hinzu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade más con el ▾ de Reproducir de un título o con clic derecho › Añadir a la cola de la fiesta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez-en d’autres avec le ▾ de Lire d’un titre ou clic droit › Ajouter à la file de la soirée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungine altri con il ▾ di Riproduci di un titolo o clic destro › Aggiungi alla coda del party."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作品の「再生」の▾、または右クリック ›「パーティの待ち行列に追加」でさらに追加できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작품의 재생 ▾ 또는 오른쪽 클릭 › 파티 대기열에 추가로 더 추가하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione mais com o ▾ de Reproduzir de um título ou clique direito › Adicionar à fila da festa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用作品“播放”旁的 ▾ 或右键 › “添加到派对队列”来添加更多。"
          }
        }
      }
    },
    "Add or download a subtitle file to show a second language under the first.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge eine Untertiteldatei hinzu oder lade sie herunter, um unter der ersten eine zweite Sprache anzuzeigen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade o descarga un archivo de subtítulos para mostrar un segundo idioma bajo el primero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez ou téléchargez un fichier de sous-titres pour afficher une deuxième langue sous la première."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi o scarica un file di sottotitoli per mostrare una seconda lingua sotto la prima."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "字幕ファイルを追加またはダウンロードすると、1つ目の下に2つ目の言語を表示できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자막 파일을 추가하거나 다운로드하면 첫 번째 자막 아래에 두 번째 언어가 표시됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione ou baixe um arquivo de legenda para mostrar um segundo idioma abaixo do primeiro."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加或下载字幕文件，在第一行下方显示第二语言。"
          }
        }
      }
    },
    "Add shows to My List, or tap Remind Me on a title, to see their next episodes here.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge Serien zu „Meine Liste“ hinzu oder tippe bei einem Titel auf „Erinnere mich“, um hier ihre nächsten Folgen zu sehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade series a Mi lista, o toca Recordármelo en un título, para ver aquí sus próximos episodios."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez des séries à Ma liste, ou touchez Me le rappeler sur un titre, pour voir ici leurs prochains épisodes."
          }
        },
        "it": {
          "stringUnit": {
