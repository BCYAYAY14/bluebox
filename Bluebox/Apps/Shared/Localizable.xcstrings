            "value": "Votre bibliothèque reste sur cet appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua libreria resta su questo dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
