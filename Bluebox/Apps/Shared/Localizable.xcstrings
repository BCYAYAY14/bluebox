    "This release streams peer to peer. Pick a debrid release, connect to Wi‑Fi, or allow torrents in Settings › Mobile Data.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Release streamt per Peer-to-Peer. Wähle ein Debrid-Release, verbinde dich mit WLAN oder erlaube Torrents unter Einstellungen › Mobile Daten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este release se transmite peer to peer. Elige un release debrid, conéctate a Wi‑Fi o permite torrents en Ajustes › Datos móviles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette release est diffusée en pair à pair. Choisissez une release debrid, connectez-vous au Wi‑Fi ou autorisez les torrents dans Réglages › Données mobiles."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa release viene trasmessa peer-to-peer. Scegli una release debrid, connettiti al Wi‑Fi, oppure consenti i torrent in Impostazioni › Rete cellulare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このリリースはピアツーピアでストリーミングされます。デブリッドのリリースを選ぶか、Wi‑Fiに接続するか、「設定 › モバイルデータ通信」でトレントを許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 릴리스는 P2P로 스트리밍됩니다. 디브리드 릴리스를 선택하거나 Wi‑Fi에 연결하거나 설정 › 모바일 데이터에서 토렌트를 허용하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta release é transmitida peer to peer. Escolha uma release debrid, conecte-se ao Wi‑Fi ou permita torrents em Ajustes › Dados Móveis."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此资源通过点对点串流。请选择 Debrid 资源、连接无线局域网，或在“设置”›“移动数据”中允许种子。"
          }
        }
      }
    },
