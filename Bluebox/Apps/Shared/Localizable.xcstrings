            "state": "translated",
            "value": "このデバイスに保存"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에 보관됨"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardado neste dispositivo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存在此设备上"
          }
        }
      }
    },
    "Kept streams are deleted. Watching them again downloads them again.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Behaltene Streams werden gelöscht. Beim erneuten Ansehen werden sie wieder geladen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las transmisiones guardadas se eliminan. Volver a verlas las descarga de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les flux conservés sont supprimés. Les regarder de nouveau les télécharge de nouveau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli stream conservati vengono eliminati. Guardarli di nuovo li scarica di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保持したストリームは削除されます。もう一度視聴すると、再びダウンロードされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보관한 스트림이 삭제됩니다. 다시 시청하면 다시 다운로드됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os streams guardados são apagados. Assisti-los de novo os baixa de novo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保留的串流将被删除。再次观看时会重新下载。"
          }
        }
      }
    },
    "Kept streams are deleted. Watching them again downloads them again. Downloads aren't affected.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Behaltene Streams werden gelöscht. Beim erneuten Ansehen werden sie wieder geladen. Downloads sind nicht betroffen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las transmisiones guardadas se eliminan. Volver a verlas las descarga de nuevo. Las descargas no se ven afectadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les flux conservés sont supprimés. Les regarder de nouveau les télécharge de nouveau. Les téléchargements ne sont pas affectés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli stream conservati vengono eliminati. Guardarli di nuovo li scarica di nuovo. I download non sono interessati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保持したストリームは削除されます。もう一度視聴すると、再びダウンロードされます。ダウンロードには影響しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보관한 스트림이 삭제됩니다. 다시 시청하면 다시 다운로드됩니다. 다운로드한 항목에는 영향이 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os streams guardados são apagados. Assisti-los de novo os baixa de novo. Os downloads não são afetados."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保留的串流将被删除。再次观看时会重新下载。下载内容不受影响。"
          }
        }
      }
    },
    "Kept streams replay without downloading again.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Behaltene Streams laufen ohne erneutes Laden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las transmisiones guardadas se reproducen de nuevo sin descargarse otra vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les flux conservés se relisent sans nouveau téléchargement."
          }
        },
        "it": {
