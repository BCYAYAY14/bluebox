    "Kids profiles show titles rated 7+ or under, and family titles where there's no rating.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kinderprofile zeigen Titel ab 7 oder darunter sowie Familientitel ohne Altersfreigabe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los perfiles infantiles muestran títulos clasificados para 7 años o menos, y títulos familiares que no tienen clasificación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les profils enfants affichent les titres classés 7+ ou moins, ainsi que les titres familiaux sans classification."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I profili bambini mostrano titoli classificati 7+ o inferiori e titoli per la famiglia se non c’è una classificazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キッズ用プロフィールでは、7+以下のレーティングの作品と、レーティングのないファミリー向け作品が表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키즈 프로필에는 7세 이상 등급 이하의 작품과, 등급이 없는 가족용 작품이 표시됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Perfis infantis mostram títulos com classificação 7+ ou menor, e títulos para a família quando não há classificação."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
