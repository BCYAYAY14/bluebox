    "Watch a film or a few episodes and your hours, top shows and genres show up here.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sieh dir einen Film oder ein paar Folgen an, und deine Stunden, Top-Serien und Genres erscheinen hier."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mira una película o unos cuantos episodios y aquí aparecerán tus horas, series y géneros principales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Regardez un film ou quelques épisodes et vos heures, séries et genres préférés apparaîtront ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda un film o qualche episodio e qui compariranno le tue ore, le serie e i generi principali."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "映画や数話のエピソードを視聴すると、視聴時間、よく見る番組とジャンルがここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "영화나 몇 편의 에피소드를 시청하면 시청 시간, 인기 프로그램, 장르가 여기에 표시됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Assista a um filme ou alguns episódios e suas horas, séries e gêneros principais aparecem aqui."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "观看一部电影或几集剧集后，你的观看小时数、热门节目和类型会显示在这里。"
          }
        }
      }
    },
