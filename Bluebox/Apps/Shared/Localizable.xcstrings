    "Renew it to keep streaming. After it ends, debrid releases won't play.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verlängere ihn, um weiter zu streamen. Danach werden Debrid-Releases nicht mehr abgespielt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Renuévalo para seguir viendo contenido. Cuando termine, las versiones de debrid no se reproducirán."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Renouvelez-le pour continuer le streaming. Une fois terminé, les versions debrid ne seront plus lues."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rinnovalo per continuare lo streaming. Dopo la scadenza, le release debrid non verranno riprodotte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ストリーミングを続けるには更新してください。終了後はデブリッドのリリースを再生できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계속 스트리밍하려면 갱신하세요. 종료되면 디브리드 릴리스가 재생되지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Renove para continuar assistindo. Depois que terminar, as versões debrid não serão reproduzidas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请续订以继续串流。到期后，Debrid 版本将无法播放。"
          }
        }
      }
    },
