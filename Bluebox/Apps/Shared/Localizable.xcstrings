    "Download a movie or an episode to watch it offline. Files in your own folders already play offline.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lade einen Film oder eine Folge, um sie offline zu sehen. Dateien in deinen eigenen Ordnern laufen bereits offline."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descarga una película o un episodio para verlo sin conexión. Los archivos de tus propias carpetas ya se reproducen sin conexión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Téléchargez un film ou un épisode pour le regarder hors ligne. Les fichiers de vos propres dossiers sont déjà lisibles hors ligne."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scarica un film o un episodio per guardarlo offline. I file nelle tue cartelle si riproducono già offline."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "映画やエピソードをダウンロードして、オフラインで視聴できます。自分のフォルダ内のファイルは、すでにオフラインで再生できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "영화나 에피소드를 다운로드하면 오프라인으로 시청할 수 있습니다. 내 폴더의 파일은 이미 오프라인에서 재생됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Baixe um filme ou episódio para assistir offline. Os arquivos das suas próprias pastas já funcionam offline."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载电影或剧集以离线观看。你自己文件夹中的文件已可离线播放。"
          }
        }
      }
    },
