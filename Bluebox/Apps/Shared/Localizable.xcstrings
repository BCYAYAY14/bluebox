    "Picture adjustments aren't available for HLS streams. They work with files, direct links, downloads and torrents.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildanpassungen sind für HLS-Streams nicht verfügbar. Sie funktionieren mit Dateien, direkten Links, Downloads und Torrents."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los ajustes de imagen no están disponibles para transmisiones HLS. Funcionan con archivos, enlaces directos, descargas y torrents."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les réglages d’image ne sont pas disponibles pour les flux HLS. Ils fonctionnent avec les fichiers, liens directs, téléchargements et torrents."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le regolazioni dell’immagine non sono disponibili per gli stream HLS. Funzionano con file, link diretti, download e torrent."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "HLSストリームでは映像の調整は使用できません。ファイル、直接リンク、ダウンロード、トレントで使用できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "HLS 스트림에서는 화면 조정을 사용할 수 없습니다. 파일, 직접 링크, 다운로드, 토렌트에서 작동합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os ajustes de imagem não estão disponíveis para streams HLS. Funcionam com arquivos, links diretos, downloads e torrents."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "HLS 串流无法调整画面。适用于文件、直接链接、下载内容和种子。"
          }
        }
      }
    },
