    },
    "Downloads on Wi‑Fi Only": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloads nur über WLAN"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descargas solo con Wi‑Fi"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Téléchargements en Wi‑Fi uniquement"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Download solo con Wi‑Fi"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi‑Fiのみでダウンロード"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi‑Fi에서만 다운로드"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloads Somente no Wi‑Fi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅使用无线局域网下载"
          }
        }
      }
    },
    "Downloads stay in the menu bar even when nothing is downloading.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloads bleiben in der Menüleiste, auch wenn nichts geladen wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las descargas permanecen en la barra de menús aunque no se descargue nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les téléchargements restent dans la barre des menus même quand rien n’est en cours."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I download restano nella barra dei menu anche quando non c’è nulla in download."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何もダウンロードしていなくても、ダウンロードをメニューバーに表示し続けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다운로드 중인 항목이 없어도 메뉴 막대에 다운로드가 유지됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os downloads ficam na barra de menus mesmo quando nada está sendo baixado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "即使没有下载，下载也会保留在菜单栏中。"
          }
        }
      }
    },
    "Downloads use mobile data too.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloads nutzen auch mobile Daten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las descargas también usan datos móviles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les téléchargements utilisent aussi les données mobiles."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I download usano anche la rete cellulare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダウンロードにはモバイルデータ通信も使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다운로드에도 모바일 데이터를 사용합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os downloads também usam dados móveis."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载也使用移动数据。"
          }
        }
      }
    },
    "Downloads wait for Wi‑Fi. Choose Download Now on a download to use mobile data for it.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloads warten auf WLAN. Wähle bei einem Download „Jetzt laden“, um dafür mobile Daten zu nutzen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las descargas esperan a una red Wi‑Fi. Elige «Descargar ahora» en una descarga para usar datos móviles con ella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les téléchargements attendent le Wi‑Fi. Choisissez « Télécharger maintenant » sur un téléchargement pour utiliser les données mobiles."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I download attendono il Wi‑Fi. Scegli “Scarica ora” su un download per usare la rete cellulare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダウンロードはWi‑Fiを待ちます。モバイルデータ通信を使うには、ダウンロードで「今すぐダウンロード」を選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다운로드는 Wi‑Fi를 기다립니다. 모바일 데이터를 사용하려면 해당 다운로드에서 지금 다운로드를 선택하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os downloads esperam pelo Wi‑Fi. Escolha Baixar Agora em um download para usar dados móveis nele."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载会等待无线局域网。对某个下载选择“立即下载”可为其使用移动数据。"
          }
        }
      }
    },
    "Downloads you start, and the next episodes Smart Downloads fetches, line up here.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Von dir gestartete Downloads und die nächsten Folgen, die intelligente Downloads laden, reihen sich hier ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las descargas que inicias, y los próximos episodios que obtienen las Descargas inteligentes, se ponen en fila aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les téléchargements que vous lancez et les prochains épisodes récupérés par les téléchargements intelligents s’alignent ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I download che avvii e i prossimi episodi scaricati dai Download intelligenti si mettono in coda qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開始したダウンロードと、スマートダウンロードが取得する次のエピソードがここに並びます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "직접 시작한 다운로드와 스마트 다운로드가 가져오는 다음 에피소드가 여기에 대기합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os downloads que você inicia e os próximos episódios que os Downloads Inteligentes buscam ficam na fila aqui."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你开始的下载以及智能下载获取的后续剧集会在此排队。"
          }
        }
      }
    },
    "Drag the bar, the subtitles on the preview, or the subtitles on the video while it plays. While the controls show, subtitles under them move up just enough to clear them.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehe die Leiste, die Untertitel in der Vorschau oder die Untertitel im Video während der Wiedergabe. Solange die Steuerung sichtbar ist, rutschen Untertitel darunter gerade so weit nach oben, dass sie frei bleiben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra la barra, los subtítulos de la vista previa o los subtítulos del video mientras se reproduce. Mientras se muestran los controles, los subtítulos que hay bajo ellos suben lo justo para despejarlos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser la barre, les sous-titres sur l’aperçu ou les sous-titres sur la vidéo pendant la lecture. Quand les commandes sont affichées, les sous-titres situés dessous remontent juste assez pour les dégager."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina la barra, i sottotitoli sull’anteprima o i sottotitoli sul video durante la riproduzione. Quando i controlli sono visibili, i sottotitoli sotto di essi si spostano in alto quanto basta per liberarli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再生中に、バー、プレビュー上の字幕、ビデオ上の字幕をドラッグできます。コントロールの表示中は、その下の字幕がちょうど重ならない位置まで上に移動します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "재생 중에 막대, 미리보기의 자막 또는 비디오의 자막을 드래그하세요. 제어기가 표시되는 동안 그 아래의 자막은 겹치지 않게 위로 올라갑니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste a barra, as legendas na prévia ou as legendas no vídeo durante a reprodução. Com os controles à mostra, as legendas abaixo deles sobem só o suficiente para liberá-los."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动进度条、预览上的字幕，或播放时视频上的字幕。显示控制项时，其下方的字幕会上移到刚好避开它们。"
          }
        }
      }
    },
    "Drag to reorder. Releases come from every add-on that's on; the order breaks ties between equally good releases.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Sortieren ziehen. Releases kommen von jedem aktiven Add-on; die Reihenfolge entscheidet bei gleich guten Releases."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra para reordenar. Los releases proceden de todos los add-ons activados; el orden desempata entre releases igual de buenos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser pour réorganiser. Les releases proviennent de tous les add-ons activés ; l’ordre départage les releases de qualité égale."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina per riordinare. Le release provengono da ogni add-on attivo; l’ordine decide a parità di qualità."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドラッグして並べ替えます。リリースはオンのすべてのアドオンから取得され、順序は同等のリリース間の優先順位になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "드래그하여 순서를 변경하세요. 릴리스는 켜져 있는 모든 애드온에서 가져오며, 품질이 같은 릴리스는 이 순서로 우선순위가 정해집니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste para reordenar. As releases vêm de todos os add-ons ativados; a ordem desempata releases igualmente boas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动以重新排序。资源来自所有已开启的附加组件；排序决定同等优质资源的先后。"
          }
        }
      }
    },
    "Drag to reorder. Select titles to remove them.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Sortieren ziehen. Wähle Titel aus, um sie zu entfernen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra para reordenar. Selecciona títulos para quitarlos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser pour réorganiser. Sélectionnez des titres pour les retirer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina per riordinare. Seleziona i titoli per rimuoverli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドラッグして並べ替えます。タイトルを選択して削除します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "드래그하여 순서를 변경하세요. 제목을 선택하여 제거하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste para reordenar. Selecione títulos para removê-los."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动以重新排序。选择标题以移除。"
          }
        }
      }
    },
