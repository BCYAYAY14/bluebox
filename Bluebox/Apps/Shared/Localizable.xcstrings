    "Pinch the trackpad to zoom; drag to pan while zoomed.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zoome per Pinch auf dem Trackpad; ziehe im Zoom, um zu verschieben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pellizca el trackpad para hacer zoom; arrastra para desplazarte mientras haces zoom."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pincez le trackpad pour zoomer ; faites glisser pour déplacer pendant le zoom."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pizzica il trackpad per ingrandire; trascina per spostarti mentre sei ingrandito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トラックパッドをピンチしてズーム、ズーム中はドラッグでパンします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "트랙패드를 핀치하여 확대하고, 확대한 상태에서 드래그하여 이동하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faça o gesto de pinça no trackpad para dar zoom; arraste para mover com zoom."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在触控板上双指张合可缩放；缩放后拖动可平移。"
          }
        }
      }
    },
