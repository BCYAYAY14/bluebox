    "You can also drag subtitles on the video, and pinch to resize.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst Untertitel auch im Video ziehen und per Pinch die Größe ändern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "También puedes arrastrar los subtítulos sobre el video y pellizcar para cambiar su tamaño."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez aussi faire glisser les sous-titres sur la vidéo et pincer pour les redimensionner."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi anche trascinare i sottotitoli sul video e pizzicare per ridimensionarli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ビデオ上で字幕をドラッグしたり、ピンチしてサイズを変更したりすることもできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비디오에서 자막을 드래그하고 핀치하여 크기를 조절할 수도 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você também pode arrastar as legendas no vídeo e usar o gesto de pinça para redimensionar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你也可以在视频上拖动字幕，并双指张合调整大小。"
          }
        }
      }
    },
