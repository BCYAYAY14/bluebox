    "Smart Downloads keeps the next episodes downloaded on Wi‑Fi.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Intelligente Downloads halten die nächsten Folgen über WLAN geladen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las descargas inteligentes mantienen descargados los próximos episodios con Wi‑Fi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les téléchargements intelligents gardent les prochains épisodes téléchargés en Wi‑Fi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I Download intelligenti mantengono scaricati i prossimi episodi con Wi‑Fi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スマートダウンロードは、Wi‑Fiで次のエピソードをダウンロードしておきます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스마트 다운로드는 Wi‑Fi로 다음 에피소드를 계속 다운로드해 둡니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os Downloads Inteligentes mantêm os próximos episódios baixados no Wi‑Fi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“智能下载”会通过无线局域网保持接下来的剧集已下载。"
          }
        }
      }
    },
    "Smart Downloads may delete downloads you've watched, always with Undo when you're here.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Intelligente Downloads löschen eventuell Downloads, die du gesehen hast, immer mit „Widerrufen“, solange du hier bist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las descargas inteligentes pueden eliminar descargas que ya has visto, siempre con Deshacer cuando estás aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les téléchargements intelligents peuvent supprimer les téléchargements que vous avez vus, toujours avec Annuler quand vous êtes là."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I Download intelligenti possono eliminare i download che hai guardato, sempre con Annulla quando sei qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スマートダウンロードは、視聴済みのダウンロードを削除することがあります。この画面を開いているときは常に取り消せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스마트 다운로드는 시청한 다운로드를 삭제할 수 있으며, 이 화면에 있을 때는 항상 실행 취소할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os Downloads Inteligentes podem apagar downloads que você já assistiu, sempre com Desfazer quando você está aqui."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“智能下载”可能会删除你已观看的下载内容，你在场时始终可以撤销。"
          }
        }
      }
    },
    "Smart Downloads never deletes anything; it only adds downloads.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Intelligente Downloads löschen nie etwas; sie fügen nur Downloads hinzu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las descargas inteligentes nunca eliminan nada; solo añaden descargas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les téléchargements intelligents ne suppriment jamais rien ; ils ne font qu’ajouter des téléchargements."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I Download intelligenti non eliminano mai nulla; aggiungono solo download."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スマートダウンロードは何も削除せず、ダウンロードを追加するだけです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스마트 다운로드는 아무것도 삭제하지 않고 다운로드만 추가합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os Downloads Inteligentes nunca apagam nada; só adicionam downloads."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“智能下载”绝不会删除任何内容；它只会添加下载。"
          }
        }
      }
    },
