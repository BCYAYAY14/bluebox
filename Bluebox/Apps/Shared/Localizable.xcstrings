    "Turned-on catalogs are rows on Home, in this order. Drag to reorder.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eingeschaltete Kataloge sind Reihen auf der Startseite, in dieser Reihenfolge. Zum Umordnen ziehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los catálogos activados son filas en Inicio, en este orden. Arrastra para reordenar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les catalogues activés sont des rangées sur l’accueil, dans cet ordre. Faites glisser pour réorganiser."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I cataloghi attivi sono righe nella Home, in quest’ordine. Trascina per riordinarli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンにしたカタログはこの順でホームのロウになります。ドラッグして並べ替えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "켜진 카탈로그는 이 순서대로 홈의 행이 됩니다. 드래그하여 순서를 바꾸세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
