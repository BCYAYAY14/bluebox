    },
    "Every saved episode is removed from this device. You can download them again later.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle gespeicherten Folgen werden von diesem Gerät entfernt. Du kannst sie später erneut laden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminan de este dispositivo todos los episodios guardados. Puedes volver a descargarlos más tarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les épisodes enregistrés sont supprimés de cet appareil. Vous pourrez les retélécharger plus tard."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti gli episodi salvati vengono rimossi da questo dispositivo. Potrai scaricarli di nuovo in seguito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存したすべてのエピソードがこのデバイスから削除されます。あとでもう一度ダウンロードできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 모든 에피소드가 이 기기에서 삭제됩니다. 나중에 다시 다운로드할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os episódios salvos são removidos deste dispositivo. Você pode baixá-los de novo depois."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有已保存的剧集都会从此设备移除。你可以稍后重新下载。"
          }
        }
      }
    },
