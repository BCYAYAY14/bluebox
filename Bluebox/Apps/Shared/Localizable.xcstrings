    "Add a folder of videos, a direct link or a Jellyfin server to watch what you already have.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge einen Ordner mit Videos, einen direkten Link oder einen Jellyfin-Server hinzu, um zu sehen, was du schon hast."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade una carpeta de videos, un enlace directo o un servidor de Jellyfin para ver lo que ya tienes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez un dossier de vidéos, un lien direct ou un serveur Jellyfin pour regarder ce que vous avez déjà."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi una cartella di video, un link diretto o un server Jellyfin per guardare ciò che hai già."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォルダ、直接リンク、またはJellyfinサーバを追加して、手持ちの作品を視聴しましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "폴더, 직접 링크 또는 Jellyfin 서버를 추가하여 이미 가지고 있는 콘텐츠를 시청하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione uma pasta de vídeos, um link direto ou um servidor Jellyfin para assistir ao que você já tem."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加视频文件夹、直接链接或 Jellyfin 服务器，观看你已有的内容。"
          }
        }
      }
    },
    "Add a free TMDB token for the full catalog.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
