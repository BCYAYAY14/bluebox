    "Get a free API key at subdl.com › Panel › API. It stays in your Keychain.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hol dir einen kostenlosen API-Schlüssel unter subdl.com › Panel › API. Er bleibt in deinem Schlüsselbund."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consigue una clave de API gratuita en subdl.com › Panel › API. Se guarda en tu llavero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Obtenez une clé d’API gratuite sur subdl.com › Panel › API. Elle reste dans votre trousseau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ottieni una chiave API gratuita su subdl.com › Panel › API. Resta nel tuo portachiavi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "subdl.com › Panel › APIで無料のAPIキーを取得できます。キーはキーチェーンに保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "subdl.com › Panel › API에서 무료 API 키를 받으세요. 키는 키체인에 보관됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Obtenha uma chave de API gratuita em subdl.com › Panel › API. Ela fica nas suas Chaves."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 subdl.com › Panel › API 获取免费 API 密钥。它保存在你的钥匙串中。"
          }
        }
      }
    },
    "Get a free token at themoviedb.org › Settings › API. It stays in your Keychain and only goes to TMDB.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hole dir ein kostenloses Token unter themoviedb.org › Settings › API. Es bleibt in deinem Schlüsselbund und geht nur an TMDB."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consigue un token gratuito en themoviedb.org › Settings › API. Se guarda en tu llavero y solo se envía a TMDB."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Obtenez un jeton gratuit sur themoviedb.org › Settings › API. Il reste dans votre Trousseau et n’est envoyé qu’à TMDB."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ottieni un token gratuito su themoviedb.org › Settings › API. Resta nel tuo Portachiavi e va solo a TMDB."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "themoviedb.org › 設定 › APIで無料のトークンを取得してください。キーチェーンに保存され、TMDBにのみ送信されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "themoviedb.org › 설정 › API에서 무료 토큰을 받으세요. 토큰은 키체인에 보관되며 TMDB로만 전송됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Obtenha um token gratuito em themoviedb.org › Settings › API. Ele fica nas suas Chaves e só vai para o TMDB."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 themoviedb.org›Settings›API 获取免费令牌。它保存在你的钥匙串中，且只会发送给 TMDB。"
          }
        }
      }
    },
