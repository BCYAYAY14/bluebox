    "Pauses when this video ends, without playing the next.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausiert am Ende dieses Videos, ohne das nächste abzuspielen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se pausa cuando termina este video, sin reproducir el siguiente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Se met en pause à la fin de cette vidéo, sans lire la suivante."
          }
        },
        "it": {
          "stringUnit": {
