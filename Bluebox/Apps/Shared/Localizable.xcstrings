        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHubから応答がありませんでした。接続を確認して、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub가 응답하지 않았습니다. 연결 상태를 확인한 다음 다시 시도하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
